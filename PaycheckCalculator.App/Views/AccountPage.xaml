<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaycheckCalculator.App.Views.AccountPage"
             Title="Account"
             BackgroundColor="{StaticResource Canvas}">

    <Grid RowDefinitions="Auto,*">

        <!-- Page Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,14,16,10">
            <Label Text="Account &amp; Sync"
                   TextColor="{StaticResource Ink}" FontSize="18" FontAttributes="Bold" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Label Text="Create an optional account to sync your saved paychecks between this app and the web app. Your paychecks are always saved on this device — an account just keeps them in sync across devices."
                       FontSize="12" TextColor="{StaticResource MutedFaint}" />

                <!-- Signed-in view -->
                <Border IsVisible="{Binding IsSignedIn}" BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="You are signed in." TextColor="{StaticResource Primary}"
                               FontSize="15" FontAttributes="Bold" />
                        <Button Text="Sync Now" Command="{Binding SyncNowCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="8" />
                        <Button Text="Export Account Data (JSON)" Command="{Binding ExportAccountDataCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource BodyText}" CornerRadius="8" />
                        <Button Text="Delete Account" Command="{Binding DeleteAccountCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource DangerStrong}" CornerRadius="8" />
                        <Button Text="Sign Out" Command="{Binding LogoutCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource DangerStrong}" CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Signed-out view: sign in / create account -->
                <Border IsVisible="{Binding IsSignedOut}" BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="EMAIL" Style="{StaticResource EyebrowLabel}" />
                        <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="you@example.com"
                               BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource Ink}" />
                        <Label Text="PASSWORD" Style="{StaticResource EyebrowLabel}" />
                        <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password"
                               BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource Ink}" />
                        <Button Text="Sign In" Command="{Binding LoginCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="8" Margin="0,4,0,0" />
                        <Button Text="Create Account" Command="{Binding RegisterCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource BodyText}" CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Busy indicator + status -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="DATA CONTROLS" Style="{StaticResource EyebrowLabel}" />
                        <Button Text="Delete Local Data" Command="{Binding DeleteLocalDataCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource DangerStrong}" CornerRadius="8" />
                        <Label Text="Deletes paychecks and budgets saved on this device only."
                               FontSize="11" TextColor="{StaticResource MutedFaint}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Server URL -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SERVER URL" Style="{StaticResource EyebrowLabel}" />
                        <Entry Text="{Binding ServerUrl}" Keyboard="Url"
                               BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource Ink}" />
                        <Label Text="The address of the sync server. Change this only if you host your own."
                               FontSize="11" TextColor="{StaticResource MutedFaint}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="LEGAL" Style="{StaticResource EyebrowLabel}" />
                        <Button Text="Privacy Policy" Command="{Binding ViewPrivacyPolicyCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource BodyText}" CornerRadius="8" />
                        <Button Text="Terms of Use" Command="{Binding ViewTermsCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource BodyText}" CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
