<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PaycheckCalculator.App.Controls"
             xmlns:helpers="clr-namespace:PaycheckCalculator.App.Helpers"
             x:Class="PaycheckCalculator.App.Views.ResultsPage"
             Title="Results"
             BackgroundColor="{StaticResource Canvas}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Print"
                     Command="{Binding PrintCommand}"
                     AutomationProperties.Name="Print results" />
        <ToolbarItem Text="Export PDF"
                     Command="{Binding ExportPdfCommand}"
                     AutomationProperties.Name="Export results to PDF" />
        <ToolbarItem Text="Export CSV"
                     Command="{Binding ExportCsvCommand}"
                     AutomationProperties.Name="Export results to CSV" />
        <ToolbarItem Text="Accuracy &amp; Sources"
                     Command="{Binding ShowAccuracySourcesCommand}"
                     AutomationProperties.Name="Show accuracy and sources" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <helpers:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Page Header -->
        <!-- Blue summary strip: the two figures that matter at a glance. -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16,14,16,14"
              ColumnDefinitions="*,*" ColumnSpacing="12"
              IsVisible="{Binding HasPaycheckResult}">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="NET PAY / PERIOD"
                       TextColor="{StaticResource OnPrimaryMuted}"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
                <Label Text="{Binding ResultCard.NetPay, StringFormat='{0:C}'}"
                       TextColor="{StaticResource OnPrimary}"
                       FontSize="22"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                <Label Text="ANNUAL TAKE-HOME"
                       TextColor="{StaticResource OnPrimaryMuted}"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       HorizontalTextAlignment="End" />
                <Label Text="{Binding Projection.AnnualizedNetPay, StringFormat='{0:C0}'}"
                       TextColor="{StaticResource OnPrimary}"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </Grid>

        <!-- Per Paycheck / Annual sub-tab switcher (annual projection is standard-mode only) -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource Surface}" Padding="12,8" ColumnSpacing="8"
              ColumnDefinitions="*,*" IsVisible="{Binding ShowResultTabs}">
            <Button Grid.Column="0" Text="Per Paycheck"
                    Command="{Binding ShowPerPeriodTabCommand}"
                    FontSize="13" CornerRadius="8" Padding="0,6" HeightRequest="40"
                    AutomationProperties.Name="Show per-paycheck results">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPerPeriodTabActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPerPeriodTabActive}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSunken}" />
                        <Setter Property="TextColor" Value="{StaticResource Muted}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Annual"
                    Command="{Binding ShowAnnualTabCommand}"
                    FontSize="13" CornerRadius="8" Padding="0,6" HeightRequest="40"
                    AutomationProperties.Name="Show annual projection">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAnnualTabActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAnnualTabActive}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSunken}" />
                        <Setter Property="TextColor" Value="{StaticResource Muted}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <ScrollView Grid.Row="2" IsVisible="{Binding HasResult}">
            <VerticalStackLayout>

            <!-- Export file name (used by the Print / Export PDF / Export CSV toolbar actions) -->
            <VerticalStackLayout Padding="16,12,16,0" Spacing="4" IsVisible="{Binding HasPaycheckResult}">
                <Label Text="EXPORT FILE NAME" Style="{StaticResource EyebrowLabel}" />
                <Entry Text="{Binding ExportFileName}" Placeholder="Paycheck-Summary"
                       AutomationProperties.Name="Export file name" />
            </VerticalStackLayout>

            <!-- ════════ HOURLY ↔ SALARY CONVERSION ════════ -->
            <!-- A pure rate conversion: gross figures only, no tax breakdown, projection, or export. -->
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding HasConversionResult}">

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="RATE CONVERSION" Style="{StaticResource EyebrowLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hourly Rate" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.HourlyRate, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" FontAttributes="Bold" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Annual Salary" TextColor="{StaticResource Ink}" FontSize="14" FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.AnnualSalary, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontSize="20" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="HOURS WORKED" Style="{StaticResource EyebrowLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hours per Week" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.HoursPerWeek, StringFormat='{0:0.##}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Paid Weeks per Year" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.WeeksPerYear, StringFormat='{0:0.##}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hours per Year" TextColor="{StaticResource Ink}" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.HoursPerYear, StringFormat='{0:0.##}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="GROSS PAY BY FREQUENCY" Style="{StaticResource EyebrowLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Weekly" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.WeeklyPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Biweekly" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.BiweeklyPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Semimonthly" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.SemimonthlyPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Monthly" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ConversionResult.MonthlyPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" FontSize="15" />
                        </Grid>
                        <Label Text="Each amount comes from the unrounded annual salary, so they need not sum back to it exactly."
                               TextColor="{StaticResource MutedFaint}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ASSUMPTIONS &amp; EXCLUSIONS" Style="{StaticResource EyebrowLabel}" />
                        <Label Text="Gross pay only: these are pre-tax figures. No federal or state withholding, FICA, or deductions are applied — switch to Standard Paycheck mode to see take-home pay."
                               TextColor="{StaticResource Warning}" FontSize="11" />
                        <Label Text="Even periods: per-frequency amounts divide the annual salary by the standard period count (52 / 26 / 24 / 12); actual paychecks can vary with the payroll calendar."
                               TextColor="{StaticResource Warning}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            <!-- /HOURLY ↔ SALARY CONVERSION -->

            <!-- ════════ PER PAYCHECK ════════ -->
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsPerPeriodTabVisible}">

                <!-- Gross-Up summary (only shown for gross-up results) -->
                <Border BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16,8"
                        IsVisible="{Binding ResultCard.IsGrossUp}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="GROSS-UP" TextColor="{StaticResource Primary}"
                               FontSize="10" FontAttributes="Bold" Margin="0,2,0,4" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Desired Net Pay (take-home)" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.TargetNetPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Taxes &amp; Deductions Covered" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.GrossUpCost, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Required Gross Pay" TextColor="{StaticResource Primary}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.GrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource WarningBg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16,10"
                        IsVisible="{Binding ResultCard.HasAccuracyNotes}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ASSUMPTIONS &amp; EXCLUSIONS" TextColor="{StaticResource Warning}"
                               FontSize="10" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResultCard.AccuracyNotes}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Description}" TextColor="{StaticResource Warning}" FontSize="11" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Bonus summary (only shown for bonus / supplemental-wage results) -->
                <Border BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16,8"
                        IsVisible="{Binding ResultCard.IsBonus}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="BONUS / SUPPLEMENTAL WAGE" TextColor="{StaticResource Primary}"
                               FontSize="10" FontAttributes="Bold" Margin="0,2,0,4" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Bonus Amount" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.GrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Total Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.TotalTaxes, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Net Bonus" TextColor="{StaticResource Primary}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.NetPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>
                        <Label Text="{Binding ResultCard.BonusStateDescription}"
                               TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,6,0,0"
                               IsVisible="{Binding ResultCard.BonusStateUsesRegularMethod}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Self-employment summary (only shown for self-employment / 1099 results) -->
                <Border BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16,8"
                        IsVisible="{Binding ResultCard.IsSelfEmployment}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="SELF-EMPLOYMENT / 1099 (ANNUAL)" TextColor="{StaticResource Primary}"
                               FontSize="10" FontAttributes="Bold" Margin="0,2,0,4" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Net Self-Employment Income" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.GrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Self-Employment Tax (15.3%)" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.FederalWithholding, StringFormat='-{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="{Binding ResultCard.StateName, StringFormat='Estimated State Income Tax ({0})'}" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.StateWithholding, StringFormat='-{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Take-Home (before federal income tax)" TextColor="{StaticResource Primary}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.NetPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>
                        <Label Text="No U.S. state levies a separate self-employment tax — self-employment income is taxed as ordinary state income (estimate)."
                               TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quarterly estimated payments (only shown for self-employment / 1099 results) -->
                <Border Style="{StaticResource CardBorder}" Padding="16,8"
                        IsVisible="{Binding ResultCard.IsSelfEmployment}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Quarterly Estimated Payments (Form 1040-ES)" TextColor="{StaticResource Primary}"
                               FontSize="13" FontAttributes="Bold" Margin="0,4,0,6" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResultCard.QuarterlyEstimates}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8" ColumnSpacing="8">
                                            <Label Text="{Binding Label}" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="13" VerticalTextAlignment="Center" />
                                            <Label Text="{Binding DueDate, StringFormat='due {0:MMM d, yyyy}'}" Grid.Column="1" TextColor="{StaticResource BodyText}" FontSize="12" VerticalTextAlignment="Center" />
                                            <Label Text="{Binding TotalAmount, StringFormat='{0:C}'}" Grid.Column="2" TextColor="{StaticResource BodyText}" FontAttributes="Bold" FontSize="13" VerticalTextAlignment="Center" />
                                        </Grid>
                                        <Label Text="{Binding FederalAmount, StringFormat='Federal {0:C}'}" TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,0,0,2" />
                                        <Label Text="{Binding StateAmount, StringFormat='State {0:C}'}" TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,0,0,4" />
                                        <BoxView Style="{StaticResource RowSeparator}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Equal installments of your estimated annual tax. The federal portion goes to the IRS; the state portion, when shown, goes to your state. Most states use these same due dates."
                               TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Per-Period (per paycheck) Results                  -->
                <!-- ═══════════════════════════════════════════════════ -->

                <!-- Income card: Gross Pay, Federal Taxable Income, FICA Taxable Income, State Taxable Income -->
                <Border Style="{StaticResource CardBorder}" Padding="16,8">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="Gross Pay" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Gross Pay is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="GrossPay" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.GrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="14" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="Federal Taxable Income" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Federal Taxable Income is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="FederalTaxableIncome" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.FederalTaxableIncome, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="FICA Taxable Income" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how FICA Taxable Income is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="FicaTaxableWages" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.FicaTaxableWages, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="State Taxable Income" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how State Taxable Income is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="StateTaxableWages" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.StateTaxableWages, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Taxes Section Header -->
                <Label Text="TAX WITHHOLDINGS" TextColor="{StaticResource MutedFaint}"
                       FontSize="10" FontAttributes="Bold"
                       Margin="4,4,0,0" />

                <!-- Tax rows card: Federal Tax, Social Security Tax, Medicare Tax, State Tax -->
                <Border Style="{StaticResource CardBorder}" Padding="16,8">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="Federal Tax" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Federal Tax is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="FederalWithholding" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.FederalWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="Social Security Tax" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Social Security is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="SocialSecurity" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.SocialSecurityWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="Medicare Tax" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Medicare is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="Medicare" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.MedicareWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Label Text="State Income Tax" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how State Income Tax is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="StateWithholding" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.StateWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"
                                 IsVisible="{Binding ResultCard.StateDisabilityInsurance, Converter={StaticResource GreaterThanZeroConverter}}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10"
                              IsVisible="{Binding ResultCard.StateDisabilityInsurance, Converter={StaticResource GreaterThanZeroConverter}}">
                            <Label Text="{Binding ResultCard.StateDisabilityInsuranceLabel}" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="&#x24D8;" Grid.Column="1" TextColor="{StaticResource Muted}"
                                   FontSize="14" Padding="6,0" VerticalTextAlignment="Center"
                                   AutomationProperties.Name="Show how State Disability is calculated">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="StateDisability" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding ResultCard.StateDisabilityInsurance, StringFormat='{0:C}'}"
                                   Grid.Column="2"
                                   TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Deductions Section Header -->
                <Label Text="DEDUCTIONS" TextColor="{StaticResource MutedFaint}"
                       FontSize="10" FontAttributes="Bold"
                       Margin="4,4,0,0"
                       IsVisible="{Binding ShowDeductions}" />

                <!-- Deductions card: Pre-Tax, Post-Tax -->
                <Border Style="{StaticResource CardBorder}" Padding="16,8"
                        IsVisible="{Binding ShowDeductions}">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10"
                              IsVisible="{Binding ResultCard.PreTaxDeductions, Converter={StaticResource GreaterThanZeroConverter}}">
                            <Label Text="Pre-Tax Deductions" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.PreTaxDeductions, StringFormat='{0:C}'}"
                                   Grid.Column="1"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"
                                 IsVisible="{Binding ShowBothDeductions}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10"
                              IsVisible="{Binding ResultCard.PostTaxDeductions, Converter={StaticResource GreaterThanZeroConverter}}">
                            <Label Text="Post-Tax Deductions" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding ResultCard.PostTaxDeductions, StringFormat='{0:C}'}"
                                   Grid.Column="1"
                                   TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Net Pay card -->
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="20,18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" CommandParameter="NetPay" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto,*" HorizontalOptions="FillAndExpand">
                            <Label Grid.Column="1" Text="NET PAY &#x24D8;" TextColor="{StaticResource OnPrimaryMuted}"
                                   FontSize="11" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   AutomationProperties.Name="Show how Net Pay is calculated" />
                        </Grid>
                        <Label Text="{Binding ResultCard.NetPay, StringFormat='{0:C}'}"
                               TextColor="{StaticResource OnPrimary}" FontAttributes="Bold" FontSize="32"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Doughnut Chart -->
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <GraphicsView x:Name="DoughnutChart"
                                  HeightRequest="380"
                                  HorizontalOptions="FillAndExpand" />
                </Border>

            </VerticalStackLayout>
            <!-- /PER PAYCHECK -->

            <!-- ════════ ANNUAL PROJECTION ════════ -->
            <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding IsAnnualTabVisible}">

                <!-- Annualized amounts -->
                <Label Text="ANNUALIZED AMOUNTS" TextColor="{StaticResource MutedFaint}"
                       FontSize="10" FontAttributes="Bold" Margin="4,0,0,0" />
                <Border Style="{StaticResource CardBorder}" Padding="16,8">
                    <VerticalStackLayout Spacing="0">

                        <Label Text="{Binding Projection.PayPeriodsPerYear, StringFormat='{0} pay periods per year'}"
                               TextColor="{StaticResource MutedFaint}" FontSize="11" Margin="0,6,0,2" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Gross Pay" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedGrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"
                                 IsVisible="{Binding Projection.ShowAnnualizedPreTaxDeductions}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10"
                              IsVisible="{Binding Projection.ShowAnnualizedPreTaxDeductions}">
                            <Label Text="Pre-Tax Deductions" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedPreTaxDeductions, StringFormat='-{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Federal Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedFederalWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="State Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedStateWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="FICA (SS + Medicare)" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedFica, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Annual Net Pay -->
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="20,18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ANNUALIZED NET PAY" TextColor="{StaticResource OnPrimaryMuted}"
                               FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Projection.AnnualizedNetPay, StringFormat='{0:C}'}"
                               TextColor="{StaticResource OnPrimary}" FontAttributes="Bold" FontSize="32"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Projected year-to-date -->
                <Label Text="{Binding Projection.PaycheckProgressLabel, StringFormat='PROJECTED YEAR-TO-DATE — {0}'}"
                       Style="{StaticResource EyebrowLabel}" Margin="4,4,0,0" />
                <Border Style="{StaticResource CardBorder}" Padding="16,8">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Remaining Paychecks" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.RemainingPaychecks}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Projected YTD Gross Pay" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.ProjectedYtdGrossPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Projected YTD Federal Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.ProjectedYtdFederalWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Projected YTD State Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.ProjectedYtdStateWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Projected YTD FICA" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.ProjectedYtdFica, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Projected YTD Net Pay" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.ProjectedYtdNetPay, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Year-end estimate -->
                <Label Text="YEAR-END ESTIMATE" TextColor="{StaticResource MutedFaint}"
                       FontSize="10" FontAttributes="Bold" Margin="4,4,0,0" />
                <Border Style="{StaticResource CardBorder}" Padding="16,8">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Est. Annual Federal Tax Liability" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.EstimatedAnnualFederalLiability, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Est. Annual FICA Liability" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.EstimatedAnnualFicaLiability, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Estimated Total Liability" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.EstimatedTotalLiability, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Text="Annualized Total Withholding" TextColor="{StaticResource BodyText}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.AnnualizedTotalWithholding, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="13" VerticalTextAlignment="Center" />
                        </Grid>

                        <BoxView Style="{StaticResource RowSeparator}" />

                        <!-- Estimated refund (over-withheld) -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12"
                              IsVisible="{Binding Projection.IsRefund}">
                            <Label Text="Withholding-Based Estimate (Over)" TextColor="{StaticResource Primary}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.OverUnderAbsolute, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>

                        <!-- Estimated amount owed (under-withheld) -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12"
                              IsVisible="{Binding Projection.IsOwe}">
                            <Label Text="Withholding-Based Estimate (Shortfall)" TextColor="{StaticResource DangerStrong}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.OverUnderAbsolute, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource DangerStrong}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>

                        <!-- Balanced -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12"
                              IsVisible="{Binding Projection.IsBalanced}">
                            <Label Text="Withholding-Based Estimate (Balanced)" TextColor="{StaticResource BodyText}" FontSize="14"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Label Text="{Binding Projection.OverUnderAbsolute, StringFormat='{0:C}'}"
                                   Grid.Column="1" TextColor="{StaticResource BodyText}" FontAttributes="Bold"
                                   FontSize="15" VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource WarningBg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="16,10"
                        IsVisible="{Binding Projection.HasAccuracyNotes}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ANNUAL ASSUMPTIONS &amp; EXCLUSIONS" TextColor="{StaticResource Warning}"
                               FontSize="10" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projection.AccuracyNotes}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Description}" TextColor="{StaticResource Warning}" FontSize="11" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            <!-- /ANNUAL PROJECTION -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- Empty / first-run state: shown until a paycheck has been calculated -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding ShowEmptyState}"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="32" Spacing="10">
            <Label Text="No paycheck calculated yet"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Enter your pay details on the Inputs tab and tap Calculate to see your paycheck breakdown here."
                   FontSize="12" TextColor="{StaticResource MutedFaint}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
