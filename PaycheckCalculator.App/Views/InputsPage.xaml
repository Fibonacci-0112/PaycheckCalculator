<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PaycheckCalculator.App.Behaviors"
             x:Class="PaycheckCalculator.App.Views.InputsPage"
             Title="Inputs"
             BackgroundColor="{StaticResource Canvas}">
    <Grid RowDefinitions="Auto,*">

        <!-- Sub-tab pills. Selection is applied in code-behind (OnTabClicked),
             which reads the same colour tokens this markup uses. -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource SurfaceSunken}"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="4"
                Margin="12,12,12,8">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <Button x:Name="TabPayHours" Text="Pay &amp; Hours"
                        Clicked="OnTabClicked"
                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                        FontSize="12" FontAttributes="Bold"
                        CornerRadius="8" BorderWidth="0"
                        Padding="2,8" Grid.Column="0" />
                <Button x:Name="TabFederal" Text="Federal"
                        Clicked="OnTabClicked"
                        BackgroundColor="Transparent" TextColor="{StaticResource Muted}"
                        FontSize="12"
                        CornerRadius="8" BorderWidth="0"
                        Padding="2,8" Grid.Column="1" />
                <Button x:Name="TabState" Text="State"
                        Clicked="OnTabClicked"
                        BackgroundColor="Transparent" TextColor="{StaticResource Muted}"
                        FontSize="12"
                        CornerRadius="8" BorderWidth="0"
                        Padding="2,8" Grid.Column="2" />
                <Button x:Name="TabDeductions" Text="Deductions"
                        Clicked="OnTabClicked"
                        BackgroundColor="Transparent" TextColor="{StaticResource Muted}"
                        FontSize="12"
                        CornerRadius="8" BorderWidth="0"
                        Padding="2,8" Grid.Column="3" />
            </Grid>
        </Border>

        <!-- Pay & Hours content -->
        <ScrollView Grid.Row="1" x:Name="PayHoursContent" IsVisible="True">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">

                        <!-- Paycheck name (identifies a saved paycheck for comparison) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Paycheck Name" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding PaycheckName}" Placeholder="e.g. Job 1"
                                   Grid.Column="1" TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}" />
                        </Grid>

                        <!-- Pay Frequency -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Pay Frequency" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedFrequencyPickerItem}"
                                    Grid.Column="1" TextColor="{StaticResource Ink}" />
                        </Grid>

                        <!-- Calculation Mode: Standard vs Gross-Up -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Mode" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding CalculationModes}" SelectedItem="{Binding SelectedCalculationModePickerItem}"
                                    Grid.Column="1" TextColor="{StaticResource Ink}" />
                        </Grid>

                        <!-- Standard paycheck inputs (Type + Hourly/Salary), hidden in gross-up mode -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStandardMode}">

                        <!-- Type: Hourly vs Salary -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Type" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding PayTypes}" SelectedItem="{Binding SelectedPayTypePickerItem}"
                                    Grid.Column="1" TextColor="{StaticResource Ink}" />
                        </Grid>

                        <!-- Hourly inputs (shown when Type = Hourly) -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsHourly}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Pay Rate" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding HourlyRate}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Regular Hours" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding RegularHours}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Overtime Hours" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding OvertimeHours}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="OT Multiplier" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding OvertimeMultiplier}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Salary inputs (shown when Type = Salary) -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsSalary}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Gross Pay Method" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding GrossPayMethods}" SelectedItem="{Binding SelectedGrossPayMethodPickerItem}"
                                        Grid.Column="1" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="{Binding SalaryAmountLabel}" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding SalaryAmount}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                        </VerticalStackLayout>

                        </VerticalStackLayout><!-- /standard paycheck inputs -->

                        <!-- Gross-up input (shown when Mode = Gross-Up) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsGrossUpMode}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Desired Net Pay" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding TargetNetPay}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Label Text="Gross-up finds the gross pay that nets this take-home amount after taxes and deductions."
                                   TextColor="{StaticResource MutedFaint}" FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Bonus / supplemental-wage input (shown when Mode = Bonus) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBonusMode}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Bonus Amount" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding BonusAmount}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Prior Supplemental Wages (this year)" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding YtdSupplementalWages}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Label Text="Bonuses use the federal flat supplemental rate — 22% (37% over $1,000,000) — plus FICA and your state's supplemental rate. Choose your work state on the State tab."
                                   TextColor="{StaticResource MutedFaint}" FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Self-employment / 1099 input (shown when Mode = Self-Employment) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSelfEmploymentMode}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Net Self-Employment Income (annual)" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding SelfEmploymentEarnings}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Label Text="Enter your annual net profit (Schedule C). Self-employment tax is 15.3% — 12.4% Social Security (to the $184,500 cap) + 2.9% Medicare — on 92.35% of it. Choose your state on the State tab for an income-tax estimate. No state has a separate self-employment tax."
                                   TextColor="{StaticResource MutedFaint}" FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Hourly ↔ salary converter (shown when Mode = Hourly ↔ Salary Converter) -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsHourlySalaryMode}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Convert" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding ConversionModes}" SelectedItem="{Binding SelectedConversionModePickerItem}"
                                        Grid.Column="1" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsHourlyToSalary}">
                                <Label Text="Hourly Rate" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ConversionHourlyRate}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsSalaryToHourly}">
                                <Label Text="Annual Salary" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ConversionAnnualSalary}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Hours per Week" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ConversionHoursPerWeek}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Label Text="Paid Weeks per Year" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ConversionWeeksPerYear}" Keyboard="Numeric" Grid.Column="1"
                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                    <Entry.Behaviors>
                                        <behaviors:DecimalFormatBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>
                            <Label Text="A pure rate conversion — no taxes, deductions, or W-4. Enter the hours you actually work (e.g. 50) to reveal the real hourly rate behind a salary, and lower the weeks per year for unpaid time off. Per-period amounts use the Pay Frequency above."
                                   TextColor="{StaticResource MutedFaint}" FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Paycheck number and YTD FICA wages — not applicable to a pure rate conversion -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsNotHourlySalaryMode}">
                        <!-- Paycheck number (for annual projection) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Paycheck # (this year)" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding PaycheckNumber}" Keyboard="Numeric" Grid.Column="1"
                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}" />
                        </Grid>

                        <!-- YTD FICA wages (for wage-base cap accuracy) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Prior Social Security Wages (this year)" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding YtdSocialSecurityWages}" Keyboard="Numeric" Grid.Column="1"
                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                <Entry.Behaviors>
                                    <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Prior Medicare Wages (this year)" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding YtdMedicareWages}" Keyboard="Numeric" Grid.Column="1"
                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                <Entry.Behaviors>
                                    <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="Prior State Wages (this year)" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding YtdStateWages}" Keyboard="Numeric" Grid.Column="1"
                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                <Entry.Behaviors>
                                    <behaviors:DecimalFormatBehavior IsCurrency="True" />
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                        <Label Text="Used where a state caps its disability or paid-leave premium at an annual wage base."
                               Style="{StaticResource FieldLabel}" FontSize="11"
                               TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>

                        <Button Text="Calculate" Command="{Binding CalculateCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold" CornerRadius="8"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Federal content -->
        <ScrollView Grid.Row="1" x:Name="FederalContent" IsVisible="False">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="14">
                        <Label Text="Filing Status" Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding FederalStatuses}" SelectedItem="{Binding SelectedFederalPickerItem}"
                                Grid.Row="0" Grid.Column="1" TextColor="{StaticResource Ink}" />
                        <Label Text="Step 2 checked?" Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <CheckBox IsChecked="{Binding FederalStep2Checked}" Grid.Row="1" Grid.Column="1"
                                  Color="{StaticResource Primary}" />
                        <Label Text="Step 3 credits (annual)" Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding FederalStep3Credits}" Keyboard="Numeric" Grid.Row="2" Grid.Column="1"
                               TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                            <Entry.Behaviors>
                                <behaviors:DecimalFormatBehavior IsCurrency="True" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="Step 4(a) other income (annual)" Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding FederalStep4aOtherIncome}" Keyboard="Numeric" Grid.Row="3" Grid.Column="1"
                               TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                            <Entry.Behaviors>
                                <behaviors:DecimalFormatBehavior IsCurrency="True" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="Step 4(b) deductions (annual)" Grid.Row="4" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding FederalStep4bDeductions}" Keyboard="Numeric" Grid.Row="4" Grid.Column="1"
                               TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                            <Entry.Behaviors>
                                <behaviors:DecimalFormatBehavior IsCurrency="True" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="Step 4(c) extra per pay" Grid.Row="5" Grid.Column="0"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding FederalStep4cExtraWithholding}" Keyboard="Numeric" Grid.Row="5" Grid.Column="1"
                               TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                            <Entry.Behaviors>
                                <behaviors:DecimalFormatBehavior IsCurrency="True" />
                            </Entry.Behaviors>
                        </Entry>
                        <Button Text="Calculate" Command="{Binding CalculateCommand}"
                                Grid.Row="6" Grid.ColumnSpan="2"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold" CornerRadius="8"
                                Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- State content -->
        <ScrollView Grid.Row="1" x:Name="StateContent" IsVisible="False">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Text="State" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding StatePickerItems}" SelectedItem="{Binding SelectedStatePickerItem}"
                                    Grid.Column="1" TextColor="{StaticResource Ink}" />
                        </Grid>

                        <Label Text="No extra inputs required for this state."
                               IsVisible="{Binding HasNoStateFields}"
                               TextColor="{StaticResource MutedFaint}" FontSize="12"
                               FontAttributes="Italic"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StateFields}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Label Text="{Binding Label}" Grid.Column="0"
                                                   Style="{StaticResource FieldLabel}" />
                                            <Picker IsVisible="{Binding IsPicker}"
                                                    ItemsSource="{Binding Options}"
                                                    SelectedItem="{Binding SelectedOption}"
                                                    Grid.Column="1" TextColor="{StaticResource Ink}" />
                                            <Entry IsVisible="{Binding IsNumeric}"
                                                   Text="{Binding StringValue}"
                                                   Keyboard="Numeric"
                                                   Grid.Column="1"
                                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}" />
                                            <Entry IsVisible="{Binding IsText}"
                                                   Text="{Binding StringValue}"
                                                   Keyboard="Default"
                                                   Grid.Column="1"
                                                   TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}" />
                                            <Switch IsVisible="{Binding IsToggle}"
                                                    IsToggled="{Binding BoolValue}"
                                                    Grid.Column="1"
                                                    OnColor="{StaticResource Primary}" />
                                        </Grid>
                                        <Label Text="{Binding ErrorMessage}"
                                               IsVisible="{Binding HasError}"
                                               TextColor="{StaticResource DangerStrong}" FontSize="10"
                                               Margin="0,-2,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StateValidationErrors}"
                                             IsVisible="{Binding HasStateValidationErrors}"
                                             Spacing="2" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" TextColor="{StaticResource DangerStrong}" FontSize="11" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="Calculate" Command="{Binding CalculateCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold" CornerRadius="8"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Deductions content -->
        <ScrollView Grid.Row="1" x:Name="DeductionsContent" IsVisible="False">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Deductions}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource SurfaceSunken}" StrokeThickness="1" Stroke="{StaticResource BorderSubtle}"
                                            StrokeShape="RoundRectangle 8" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                              RowSpacing="8" ColumnSpacing="8">
                                            <Entry Grid.Row="0" Grid.Column="0" Placeholder="Name (e.g. 401k)"
                                                   Text="{Binding Name}" TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                                <Entry.Triggers>
                                                    <DataTrigger TargetType="Entry" Binding="{Binding HasNameError}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource DangerBg}" />
                                                    </DataTrigger>
                                                </Entry.Triggers>
                                            </Entry>
                                            <Button Grid.Row="0" Grid.Column="1" Text="✕"
                                                    FontSize="12" Padding="6,2"
                                                    BackgroundColor="{StaticResource Danger}" TextColor="{StaticResource OnPrimary}" CornerRadius="4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveDeductionCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Label Text="Amount" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Entry Grid.Column="1" Text="{Binding Amount}" Keyboard="Numeric"
                                                       TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource SurfaceSunken}">
                                                    <Entry.Behaviors>
                                                        <behaviors:DecimalFormatBehavior IsCurrency="{Binding IsDollarAmount}"
                                                                                        IsPercentage="{Binding IsPercentageAmount}" />
                                                    </Entry.Behaviors>
                                                </Entry>
                                            </Grid>
                                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Label Text="Amount Type" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Picker Grid.Column="1" ItemsSource="{Binding AmountTypes}"
                                                        SelectedItem="{Binding AmountType}" TextColor="{StaticResource Ink}" />
                                            </Grid>
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Label Text="Type" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Picker Grid.Column="1" ItemsSource="{Binding DeductionTypeItems}"
                                                        SelectedItem="{Binding SelectedDeductionTypePickerItem}" TextColor="{StaticResource Ink}" />
                                            </Grid>
                                            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="Reduces Federal Taxable Income" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Switch Grid.Column="1" IsToggled="{Binding ReducesFederalTaxableWages}"
                                                        OnColor="{StaticResource Primary}" />
                                            </Grid>
                                            <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="Reduces State Taxable Income" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Switch Grid.Column="1" IsToggled="{Binding ReducesStateTaxableWages}"
                                                        OnColor="{StaticResource Primary}" />
                                            </Grid>
                                            <Grid Grid.Row="6" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="Reduces FICA Taxable Income" TextColor="{StaticResource Muted}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Switch Grid.Column="1" IsToggled="{Binding ReducesFicaWages}"
                                                        OnColor="{StaticResource Primary}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="+ Add Deduction" Command="{Binding AddDeductionCommand}"
                                BackgroundColor="{StaticResource SurfaceSunken}" TextColor="{StaticResource BodyText}"
                                FontAttributes="Bold" CornerRadius="8" />

                        <Button Text="Calculate" Command="{Binding CalculateCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold" CornerRadius="8"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
