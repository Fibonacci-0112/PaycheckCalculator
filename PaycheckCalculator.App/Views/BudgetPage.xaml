<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaycheckCalculator.App.ViewModels"
             xmlns:helpers="clr-namespace:PaycheckCalculator.App.Helpers"
             x:Class="PaycheckCalculator.App.Views.BudgetPage"
             Title="Budget"
             BackgroundColor="{StaticResource Canvas}">

    <ContentPage.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBool" />
        <helpers:StringToBoolConverter x:Key="StringToBool" />
    </ContentPage.Resources>

    <ScrollView AutomationId="Page_Budget">
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Monthly income header -->
            <Border BackgroundColor="{StaticResource Surface}" Padding="12" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Monthly Net Income" FontSize="12" TextColor="{StaticResource MutedFaint}" />
                    <Label Text="{Binding MonthlyNetIncome, StringFormat='{0:C}'}"
                           FontSize="28" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                    <Label IsVisible="{Binding HasIncome, Converter={StaticResource InvertBool}}"
                           Text="Pick a method and tap 'Apply Template' after calculating a paycheck"
                           FontSize="12" TextColor="{StaticResource MutedFaint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Method + apply action -->
            <Border BackgroundColor="{StaticResource Surface}" Padding="12" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Budgeting Method" FontSize="12" TextColor="{StaticResource MutedFaint}" />
                    <Picker ItemsSource="{Binding Methods}"
                            SelectedItem="{Binding Method}"
                            TextColor="{StaticResource OnPrimary}" TitleColor="#666" />
                    <Button Text="Apply Template from Last Paycheck"
                            Command="{Binding ApplyMethodTemplateCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <!-- Summary row -->
            <Grid IsVisible="{Binding HasCategories}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" Padding="10" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Budgeted" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                        <Label Text="{Binding TotalBudgeted, StringFormat='{0:C}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" Padding="10" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Spent" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                        <Label Text="{Binding TotalSpent, StringFormat='{0:C}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recurring / savings summary row -->
            <Grid IsVisible="{Binding HasCategories}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" Padding="10" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Recurring (monthly)" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                        <Label Text="{Binding TotalRecurring, StringFormat='{0:C}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" Padding="10" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Savings goals (monthly)" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                        <Label Text="{Binding TotalSavingsContribution, StringFormat='{0:C}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Zero-based allocation indicator -->
            <Border IsVisible="{Binding HasCategories}" BackgroundColor="{StaticResource Surface}" Padding="10" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Unallocated income" FontSize="12" TextColor="{StaticResource MutedFaint}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Unallocated, StringFormat='{0:C}'}"
                           FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" HorizontalOptions="End" />
                </Grid>
            </Border>

            <!-- Category list -->
            <Label Text="Budget Categories" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                   IsVisible="{Binding HasCategories}" />

            <CollectionView ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BudgetCategoryViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetViewModel}},
                                                                  Path=RemoveCategoryCommand}"
                                               CommandParameter="{Binding}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="{StaticResource Surface}" Padding="12" Margin="0,0,0,8" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,8,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}" FontSize="16"
                                           FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding BudgetTypeLabel}" FontSize="11"
                                           TextColor="{StaticResource MutedFaint}" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Budgeted, StringFormat='Budgeted: {0:C}'}"
                                           FontSize="12" TextColor="{StaticResource MutedFaint}" />
                                    <!-- Progress bar: Spent / Budgeted -->
                                    <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding Spent}"
                                                 ProgressColor="{StaticResource Primary}"
                                                 BackgroundColor="{StaticResource BorderSubtle}" />
                                    <Label Grid.Row="3" Grid.Column="0"
                                           Text="{Binding Spent, StringFormat='Spent: {0:C}'}"
                                           FontSize="12" TextColor="{StaticResource OnPrimary}" />
                                    <Label Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Remaining, StringFormat='Left: {0:C}'}"
                                           FontSize="12" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                                    <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Recurring, StringFormat='Recurring bills: {0:C}/mo'}"
                                           FontSize="11" TextColor="{StaticResource MutedFaint}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add category (user-defined) -->
            <Button Text="Add Category"
                    Command="{Binding AddCategoryCommand}"
                    IsVisible="{Binding HasIncome}"
                    BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                    CornerRadius="6" HeightRequest="40" />

            <!-- Add transaction -->
            <Label Text="Add Expense" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                   IsVisible="{Binding HasCategories}" />

            <Border BackgroundColor="{StaticResource Surface}" Padding="12"
                   IsVisible="{Binding HasCategories}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Entry Placeholder="Category" Text="{Binding NewTransactionCategory}"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Amount" Text="{Binding NewTransactionAmount}"
                           Keyboard="Numeric"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Description (optional)" Text="{Binding NewTransactionDescription}"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Button Text="Add Expense"
                            Command="{Binding AddTransactionAsyncCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                            CornerRadius="6" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- Transaction list -->
            <Label Text="This Month's Expenses" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                   IsVisible="{Binding HasTransactions}" />

            <CollectionView ItemsSource="{Binding Transactions}" IsVisible="{Binding HasTransactions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BudgetTransactionViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetViewModel}},
                                                                  Path=RemoveTransactionCommand}"
                                               CommandParameter="{Binding}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="{StaticResource Surface}" Padding="10" Margin="0,0,0,4" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding CategoryName}" FontSize="14"
                                               FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                                        <Label Text="{Binding Description}" FontSize="11"
                                               TextColor="{StaticResource MutedFaint}"
                                               IsVisible="{Binding Description, Converter={StaticResource StringToBool}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='{0:C}'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding DisplayDate}" FontSize="11"
                                               TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── RECURRING BILLS ─────────────────────────────────── -->
            <Label Text="Recurring Bills" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                   IsVisible="{Binding HasIncome}" />

            <CollectionView ItemsSource="{Binding RecurringBills}" IsVisible="{Binding HasRecurringBills}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecurringBillViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetViewModel}},
                                                                  Path=RemoveBillCommand}"
                                               CommandParameter="{Binding}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="{StaticResource Surface}" Padding="10" Margin="0,0,0,4" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14"
                                               FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                                        <Label Text="{Binding CategoryName}" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='{0:C}'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding MonthlyEquivalent, StringFormat='{0:C}/mo'}"
                                               FontSize="11" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                                        <Label Text="{Binding FrequencyLabel}" FontSize="11"
                                               TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="{StaticResource Surface}" Padding="12"
                   IsVisible="{Binding HasIncome}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Entry Placeholder="Bill name (e.g. Rent)" Text="{Binding NewBillName}"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Category" Text="{Binding NewBillCategory}"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Amount" Text="{Binding NewBillAmount}" Keyboard="Numeric"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding NewBillFrequency}"
                            Title="Frequency" TextColor="{StaticResource OnPrimary}" TitleColor="#666" />
                    <Button Text="Add Bill"
                            Command="{Binding AddBillAsyncCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                            CornerRadius="6" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- ── SAVINGS GOALS ───────────────────────────────────── -->
            <Label Text="Savings Goals" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                   IsVisible="{Binding HasIncome}" />

            <CollectionView ItemsSource="{Binding SavingsGoals}" IsVisible="{Binding HasSavingsGoals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SavingsGoalViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetViewModel}},
                                                                  Path=RemoveGoalCommand}"
                                               CommandParameter="{Binding}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="{StaticResource Surface}" Padding="10" Margin="0,0,0,4" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="14"
                                           FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding MonthlyContributionNeeded, StringFormat='{0:C}/mo'}"
                                           FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                                           HorizontalOptions="End" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding TargetDateLabel}" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding CurrentAmount, StringFormat='Saved {0:C}'}"
                                           FontSize="11" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="{StaticResource Surface}" Padding="12"
                   IsVisible="{Binding HasIncome}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Entry Placeholder="Goal name (e.g. Vacation)" Text="{Binding NewGoalName}"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Target amount" Text="{Binding NewGoalTarget}" Keyboard="Numeric"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Entry Placeholder="Saved so far" Text="{Binding NewGoalCurrent}" Keyboard="Numeric"
                           PlaceholderColor="{StaticResource MutedFaint}" TextColor="{StaticResource OnPrimary}" BackgroundColor="Transparent" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Switch Grid.Column="0" IsToggled="{Binding NewGoalHasDate}" />
                        <DatePicker Grid.Column="1" Date="{Binding NewGoalDate}" IsEnabled="{Binding NewGoalHasDate}"
                                    TextColor="{StaticResource OnPrimary}" />
                    </Grid>
                    <Button Text="Add Goal"
                            Command="{Binding AddGoalAsyncCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                            CornerRadius="6" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- ── REPORTS (C3 - Pro-gated) ───────────────────────── -->
            <Label Text="Budget Reports &amp; Insights" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" />

            <!-- Pro gate -->
            <Border BackgroundColor="{StaticResource Surface}" Padding="16"
                   IsVisible="{Binding IsPro, Converter={StaticResource InvertBool}}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Pro Feature" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="Budget reports — spend history and trends — are available on the Pro plan."
                           FontSize="12" TextColor="{StaticResource MutedFaint}" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Report controls (Pro only) -->
            <Border BackgroundColor="{StaticResource Surface}" Padding="12"
                   IsVisible="{Binding IsPro}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Months to include" FontSize="12" TextColor="{StaticResource MutedFaint}" />
                            <Stepper Minimum="1" Maximum="12" Increment="1"
                                     Value="{Binding ReportMonthsBack}" />
                            <Label Text="{Binding ReportMonthsBack, StringFormat='{0} months'}"
                                   FontSize="12" TextColor="{StaticResource MutedFaint}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Generate"
                                Command="{Binding GenerateReportCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                CornerRadius="6" HeightRequest="48"
                                VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Report results -->
            <Border BackgroundColor="{StaticResource Surface}" Padding="12"
                   IsVisible="{Binding HasReport}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*">
                        <Label Grid.Column="0" Text="Budget vs Actual" FontSize="13"
                               FontAttributes="Bold" TextColor="#ccc" />
                        <Button Grid.Column="1" Text="Export CSV"
                                Command="{Binding ExportReportCsvAsyncCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                CornerRadius="6" HeightRequest="36"
                                HorizontalOptions="End" />
                    </Grid>

                    <!-- Budget vs Actual table header -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Month" FontSize="11" TextColor="{StaticResource MutedFaint}" />
                        <Label Grid.Column="1" Text="Budgeted" FontSize="11" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                        <Label Grid.Column="2" Text="Actual" FontSize="11" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                        <Label Grid.Column="3" Text="Variance" FontSize="11" TextColor="{StaticResource MutedFaint}" HorizontalOptions="End" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Report.BudgetVsActual}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,3">
                                    <Label Grid.Column="0"
                                           Text="{Binding Month, StringFormat='{0:MMM yyyy}'}"
                                           FontSize="13" TextColor="{StaticResource OnPrimary}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Budgeted, StringFormat='{0:C}'}"
                                           FontSize="13" TextColor="{StaticResource OnPrimary}" HorizontalOptions="End" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Actual, StringFormat='{0:C}'}"
                                           FontSize="13" TextColor="{StaticResource OnPrimary}" HorizontalOptions="End" />
                                    <Label Grid.Column="3"
                                           Text="{Binding Variance, StringFormat='{0:C}'}"
                                           FontSize="13" TextColor="{StaticResource OnPrimary}" HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
