<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <LangVersion>preview</LangVersion>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PaycheckCalculator</ApplicationTitle>
    <ApplicationId>com.erik.paycheckcalc</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug'">
    <!-- Fast Deployment relies on the Android `run-as` feature, which some devices/emulators
         don't support (or support only partially), causing XA0129 ("Error deploying
         'files/.__override__'..."). Embedding assemblies into the APK for Debug builds avoids
         Fast Deployment entirely; debugging still works, just with a slower deploy step. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The Windows XAML compiler can report design-time WMC1006 warnings for project-reference outputs before Core/Shared have been built. -->
    <NoWarn>$(NoWarn);WMC1006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adaptive launcher icon. The background layer carries the plate gradient and
         the foreground the artwork, inset so it stays inside Android's 66dp safe zone
         (see docs/brand/README.md). Color is the flat fallback painted under the
         background layer, and is what iOS/Mac Catalyst use as the icon background. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.60" Color="#0158D3" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0158D3" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\ok_ow2_2026_percentage.json" LogicalName="ok_ow2_2026_percentage.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\us_irs_15t_2026_percentage_automated.json" LogicalName="us_irs_15t_2026_percentage_automated.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\ca_method_b_2026.json" LogicalName="ca_method_b_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\ar_withholding_2026.json" LogicalName="ar_withholding_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\co_dr0004_2026.json" LogicalName="co_dr0004_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\connecticut_withholding_2026.json" LogicalName="connecticut_withholding_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\state_supplemental_2026.json" LogicalName="state_supplemental_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\tax_source_manifest_2026.json" LogicalName="tax_source_manifest_2026.json" />
	<MauiAsset Include="..\PaycheckCalculator.Core\Data\Schemas\*.json" LogicalName="schemas\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaycheckCalculator.Core\PaycheckCalculator.Core.csproj" />
    <ProjectReference Include="..\PaycheckCalculator.Shared\PaycheckCalculator.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Images\" />
  </ItemGroup>

</Project>
