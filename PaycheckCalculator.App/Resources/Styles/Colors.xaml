<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Design tokens for the app. These mirror the CSS custom properties in
    PaycheckCalculator.Blazor/wwwroot/app.css so the two front-ends read as one
    product. Pages should reference these keys rather than inlining hex literals.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryDarker">#1E40AF</Color>
    <Color x:Key="PrimaryTint">#EFF6FF</Color>
    <Color x:Key="PrimaryTintStrong">#DBEAFE</Color>

    <!-- Chart ramp -->
    <Color x:Key="Chart2">#60A5FA</Color>
    <Color x:Key="Chart3">#94A3B8</Color>
    <Color x:Key="Chart4">#475569</Color>

    <!-- Semantics -->
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerStrong">#DC2626</Color>
    <Color x:Key="DangerBg">#FEF2F2</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessBg">#DCFCE7</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="WarningBg">#FEF3C7</Color>

    <!-- Text -->
    <Color x:Key="Ink">#0F172A</Color>
    <Color x:Key="InkSoft">#1E293B</Color>
    <Color x:Key="BodyText">#334155</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="MutedFaint">#94A3B8</Color>

    <!-- Surfaces -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceSunken">#F8FAFC</Color>
    <Color x:Key="Canvas">#F5F7FA</Color>
    <Color x:Key="BorderSubtle">#E2E8F0</Color>
    <Color x:Key="BorderStrong">#CBD5E1</Color>

    <!-- On-hero text (translucent white reads poorly as a literal at call sites) -->
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryMuted">#BFDBFE</Color>

</ResourceDictionary>
