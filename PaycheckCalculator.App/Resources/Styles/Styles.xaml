<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Named styles built on the tokens in Colors.xaml. Colors.xaml must be merged
    first in App.xaml so these StaticResource lookups resolve.

    Implicit styles at the bottom keep the compact sizing the pages were built
    around. The keyed styles above replace the card, separator, eyebrow and
    field-label literals that were previously repeated across every page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Cards ───────────────────────────────────────────────── -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ── Text ────────────────────────────────────────────────── -->
    <Style x:Key="EyebrowLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource MutedFaint}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ── Misc ────────────────────────────────────────────────── -->
    <Style x:Key="RowSeparator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource BorderSubtle}" />
    </Style>

    <!-- ── Implicit defaults ───────────────────────────────────────
         Compact sizing so inputs and results fit on small mobile screens.
         Controls without an explicit FontSize inherit these. -->
    <Style TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource BodyText}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>
