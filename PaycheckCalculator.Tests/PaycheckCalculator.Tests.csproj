<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.7.26381.103" />
    <!-- Must match the EF Core version pinned by PaycheckCalculator.API's Npgsql provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaycheckCalculator.Core\PaycheckCalculator.Core.csproj" />
    <ProjectReference Include="..\PaycheckCalculator.Shared\PaycheckCalculator.Shared.csproj" />
    <ProjectReference Include="..\PaycheckCalculator.API\PaycheckCalculator.API.csproj" />
    <!-- Referenced for the Blazor export renderers (CSV/PDF), which build on Linux/CI without the MAUI
         workload. Aliased to 'blazor' so the web host's top-level Program type stays out of the global
         namespace and does not collide with PaycheckCalculator.API's Program (used by SyncApiTest). -->
    <ProjectReference Include="..\PaycheckCalculator.Blazor\PaycheckCalculator.Blazor.csproj">
      <Aliases>blazor</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PaycheckCalculator.Core\Data\ok_ow2_2026_percentage.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ok_ow2_2026_percentage.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\ca_method_b_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ca_method_b_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\us_irs_15t_2026_percentage_automated.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>us_irs_15t_2026_percentage_automated.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\ar_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ar_withholding_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\co_dr0004_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>co_dr0004_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\connecticut_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>connecticut_withholding_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\state_supplemental_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>state_supplemental_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\tax_source_manifest_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>tax_source_manifest_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalculator.Core\Data\Schemas\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Schemas\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
