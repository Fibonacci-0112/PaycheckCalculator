@page "/"
@rendermode InteractiveServer
@inject PayCalculator Calc
@inject AnnualProjectionCalculator ProjectionCalc
@inject GrossUpCalculator GrossUpCalc
@inject StateCalculatorRegistry StateRegistry
@inject IStateSchemaProvider SchemaProvider
@inject SessionPaycheckStore Store
@inject CircuitAccountSession Account
@inject PaycheckApiClient Api
@inject PaycheckSyncService Sync

<PageTitle>PaycheckCalc — 2026 US Paycheck Calculator</PageTitle>

<div class="calc-layout">

    <!-- ── INPUTS PANEL ─────────────────────────────────────── -->
    <div class="calc-panel">
        <div class="panel-header">
            <h2>Inputs</h2>
        </div>

        <div class="tab-bar">
            <button class="tab-btn @(_inputTab == 0 ? "active" : "")" @onclick="() => _inputTab = 0">Pay &amp; Hours</button>
            <button class="tab-btn @(_inputTab == 1 ? "active" : "")" @onclick="() => _inputTab = 1">Federal W-4</button>
            <button class="tab-btn @(_inputTab == 2 ? "active" : "")" @onclick="() => _inputTab = 2">State</button>
            <button class="tab-btn @(_inputTab == 3 ? "active" : "")" @onclick="() => _inputTab = 3">Deductions</button>
        </div>

        <div class="tab-content">

            @if (_inputTab == 0)
            {
                <!-- Pay & Hours -->
                <div class="form-group">
                    <label>Pay Frequency</label>
                    <select @bind="_frequency">
                        @foreach (var f in Enum.GetValues<PayFrequency>())
                        {
                            <option value="@f">@FrequencyLabel(f)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Pay Date</label>
                    <input type="date" @bind="_payDate" />
                    <p class="form-note">The date of an upcoming paycheck. For weekly/biweekly pay this determines whether the year has an extra (53rd/27th) paycheck, which affects tax withholding.</p>
                </div>
                <div class="form-group">
                    <label>Calculation Mode</label>
                    <select @bind="_mode" @bind:after="OnModeChanged">
                        <option value="standard">Standard paycheck (gross &rarr; net)</option>
                        <option value="grossup">Gross-up (net &rarr; required gross)</option>
                    </select>
                </div>

                @if (!_grossUpMode)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Hourly Rate ($)</label>
                            <input type="number" @bind="_hourlyRate" min="0" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Regular Hours</label>
                            <input type="number" @bind="_regularHours" min="0" step="0.5" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Overtime Hours</label>
                            <input type="number" @bind="_overtimeHours" min="0" step="0.5" />
                        </div>
                        <div class="form-group">
                            <label>OT Multiplier</label>
                            <input type="number" @bind="_overtimeMultiplier" min="1" step="0.25" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Desired Net Pay &mdash; take-home this period ($)</label>
                        <input type="number" @bind="_targetNet" min="0" step="0.01" />
                    </div>
                    <p class="form-note">Enter the exact take-home amount. Gross-up finds the gross pay that nets it after taxes and deductions &mdash; used for net bonuses and relocation payments.</p>
                }
                <div class="form-group">
                    <label>Paycheck # This Year</label>
                    <input type="number" @bind="_paycheckNumber" min="1" max="365" />
                </div>
                <div class="form-section-title">Year-to-Date Wages (for FICA caps)</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>YTD Social Security Wages ($)</label>
                        <input type="number" @bind="_ytdSsWages" min="0" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>YTD Medicare Wages ($)</label>
                        <input type="number" @bind="_ytdMedWages" min="0" step="0.01" />
                    </div>
                </div>
            }

            @if (_inputTab == 1)
            {
                <!-- Federal W-4 -->
                <div class="form-group">
                    <label>Filing Status</label>
                    <select @bind="_fedStatus">
                        <option value="@FederalFilingStatus.SingleOrMarriedSeparately">Single / Married Filing Separately</option>
                        <option value="@FederalFilingStatus.MarriedFilingJointly">Married Filing Jointly</option>
                        <option value="@FederalFilingStatus.HeadOfHousehold">Head of Household</option>
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="step2" @bind="_step2Checked" />
                    <label for="step2">Step 2: Multiple jobs / spouse also works</label>
                </div>
                <p class="form-note">Checking Step 2 halves the standard deduction, increasing withholding for dual-income households.</p>
                <div class="form-group">
                    <label>Step 3 — Tax Credits (annual $)</label>
                    <input type="number" @bind="_step3Credits" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(a) — Other Income (annual $)</label>
                    <input type="number" @bind="_step4aIncome" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(b) — Deductions (annual $)</label>
                    <input type="number" @bind="_step4bDeductions" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(c) — Extra Withholding (per paycheck $)</label>
                    <input type="number" @bind="_step4cExtra" min="0" step="0.01" />
                </div>
            }

            @if (_inputTab == 2)
            {
                <!-- State -->
                <div class="form-group">
                    <label>State</label>
                    <select @bind="_state" @bind:after="LoadStateFields">
                        @foreach (var s in Enum.GetValues<UsState>())
                        {
                            <option value="@s">@s.ToString()</option>
                        }
                    </select>
                </div>

                @if (_stateFields.Count == 0)
                {
                    <p class="no-fields-msg">No additional withholding inputs required for @_state.</p>
                }
                else
                {
                    @foreach (var field in _stateFields)
                    {
                        <div class="form-group @(field.HasError ? "has-error" : "")">
                            <label>@field.Label</label>
                            @if (field.FieldType == StateFieldType.Picker)
                            {
                                <select @bind="field.SelectedOption">
                                    @if (field.Options != null)
                                    {
                                        @foreach (var opt in field.Options)
                                        {
                                            <option value="@opt">@opt</option>
                                        }
                                    }
                                </select>
                            }
                            else if (field.FieldType == StateFieldType.Toggle)
                            {
                                <div class="toggle-row">
                                    <input type="checkbox" @bind="field.BoolValue" />
                                    <span class="toggle-label">@(field.BoolValue ? "Yes" : "No")</span>
                                </div>
                            }
                            else
                            {
                                <input type="number"
                                       @bind="field.StringValue"
                                       step="@(field.FieldType == StateFieldType.Integer ? "1" : "0.01")" />
                            }
                            @if (field.HasError)
                            {
                                <span class="field-error">@field.ErrorMessage</span>
                            }
                        </div>
                    }
                }

                @if (_stateErrors.Count > 0)
                {
                    <div class="state-validation-errors">
                        @foreach (var err in _stateErrors)
                        {
                            <p>@err</p>
                        }
                    </div>
                }
            }

            @if (_inputTab == 3)
            {
                <!-- Deductions -->
                @if (_deductions.Count == 0)
                {
                    <p class="no-fields-msg">No deductions added. Use pre-tax deductions (401k, HSA) or post-tax deductions.</p>
                }

                @foreach (var ded in _deductions.ToList())
                {
                    <div class="deduction-card">
                        <div class="deduction-header">
                            <input type="text" @bind="ded.Name" placeholder="Name (e.g. 401k, Health)" class="ded-name" />
                            <button class="btn-icon btn-danger" @onclick="() => RemoveDeduction(ded)" title="Remove">x</button>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Amount</label>
                                <input type="number" @bind="ded.Amount" min="0" step="0.01" />
                            </div>
                            <div class="form-group">
                                <label>Amount Type</label>
                                <select @bind="ded.AmountType">
                                    <option value="@DeductionAmountType.Dollar">Dollar ($)</option>
                                    <option value="@DeductionAmountType.Percentage">Percentage (%)</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Deduction Type</label>
                            <select @bind="ded.Type">
                                <option value="@DeductionType.PreTax">Pre-Tax</option>
                                <option value="@DeductionType.PostTax">Post-Tax</option>
                            </select>
                        </div>
                        <div class="deduction-flags">
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesFederalTaxableWages" />
                                Reduces Federal Taxable Wages
                            </label>
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesStateTaxableWages" />
                                Reduces State Taxable Wages
                            </label>
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesFicaWages" />
                                Reduces FICA Wages
                            </label>
                        </div>
                    </div>
                }

                <button class="btn-secondary" @onclick="AddDeduction">+ Add Deduction</button>
            }

        </div><!-- /tab-content -->

        <div class="action-bar">
            <input type="text" class="paycheck-name-input" @bind="_paycheckName" placeholder="Paycheck name (optional)" />
            <button class="btn-calculate" @onclick="Calculate">Calculate</button>
            @if (_calcError != null)
            {
                <div class="calc-error">@_calcError</div>
            }
        </div>

    </div><!-- /inputs panel -->

    <!-- ── RESULTS PANEL ─────────────────────────────────────── -->
    <div class="calc-panel results-outer">
        <div class="panel-header">
            <h2>Results</h2>
        </div>

        @if (_result == null)
        {
            <div class="results-placeholder">
                <div class="placeholder-icon">&#9881;</div>
                <p>Enter your paycheck information and click <strong>Calculate</strong> to see your results.</p>
            </div>
        }
        else
        {
            @if (_grossUpResult == null)
            {
                <div class="tab-bar">
                    <button class="tab-btn @(_resultTab == 0 ? "active" : "")" @onclick="() => _resultTab = 0">Per Paycheck</button>
                    <button class="tab-btn @(_resultTab == 1 ? "active" : "")" @onclick="() => _resultTab = 1">Annual</button>
                </div>
            }

            @if (_resultTab == 0 || _grossUpResult != null)
            {
                <!-- Period results -->
                <div class="results-scroll">
                    @if (_grossUpResult != null)
                    {
                        <div class="result-card card-refund">
                            <div class="result-card-title">Gross-Up Result</div>
                            <div class="result-row">
                                <span>Desired Net Pay (take-home)</span>
                                <span class="result-value">@_grossUpResult.TargetNetPay.ToString("C")</span>
                            </div>
                            <div class="result-row">
                                <span>Taxes &amp; Deductions Covered</span>
                                <span class="result-value">@_grossUpResult.GrossUpCost.ToString("C")</span>
                            </div>
                            <div class="result-row result-net-row">
                                <span class="net-label">Required Gross Pay</span>
                                <span class="result-value net-value">@_grossUpResult.GrossUpPay.ToString("C")</span>
                            </div>
                            @if (!_grossUpResult.Converged)
                            {
                                <div class="result-row">
                                    <span class="result-value deduction">Could not reach the target net with these inputs.</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="result-card">
                        <div class="result-card-title">Income</div>
                        <div class="result-row">
                            <span>Gross Pay</span>
                            <div class="result-right">
                                <span class="result-value">@_result.GrossPay.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.GrossPay)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row result-sub">
                            <span>Federal Taxable Income</span>
                            <span class="result-value sub">@_result.FederalTaxableIncome.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>FICA Taxable Wages</span>
                            <span class="result-value sub">@_result.FicaTaxableWages.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>@_result.State Taxable Wages</span>
                            <span class="result-value sub">@_result.StateTaxableWages.ToString("C")</span>
                        </div>
                    </div>

                    @if (_result.PreTaxDeductions > 0 || _result.PostTaxDeductions > 0)
                    {
                        <div class="result-card">
                            <div class="result-card-title">Deductions</div>
                            @if (_result.PreTaxDeductions > 0)
                            {
                                <div class="result-row">
                                    <span>Pre-Tax Deductions</span>
                                    <span class="result-value deduction">-@_result.PreTaxDeductions.ToString("C")</span>
                                </div>
                            }
                            @if (_result.PostTaxDeductions > 0)
                            {
                                <div class="result-row">
                                    <span>Post-Tax Deductions</span>
                                    <span class="result-value deduction">-@_result.PostTaxDeductions.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="result-card">
                        <div class="result-card-title">Tax Withholdings</div>
                        <div class="result-row">
                            <span>Federal Income Tax</span>
                            <div class="result-right">
                                <span class="result-value">@_result.FederalWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.FederalWithholding)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row">
                            <span>Social Security (6.2%)</span>
                            <div class="result-right">
                                <span class="result-value">@_result.SocialSecurityWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.SocialSecurity)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row">
                            <span>Medicare (1.45%)</span>
                            <div class="result-right">
                                <span class="result-value">@_result.MedicareWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.Medicare)' title="Show calculation">?</button>
                            </div>
                        </div>
                        @if (_result.AdditionalMedicareWithholding > 0)
                        {
                            <div class="result-row">
                                <span>Additional Medicare (0.9%)</span>
                                <div class="result-right">
                                    <span class="result-value">@_result.AdditionalMedicareWithholding.ToString("C")</span>
                                    <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.AdditionalMedicare)' title="Show calculation">?</button>
                                </div>
                            </div>
                        }
                        <div class="result-row">
                            <span>@_result.State State Income Tax</span>
                            <div class="result-right">
                                <span class="result-value">@_result.StateWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.StateWithholding)' title="Show calculation">?</button>
                            </div>
                        </div>
                        @if (_result.StateDisabilityInsurance > 0)
                        {
                            <div class="result-row">
                                <span>@_result.StateDisabilityInsuranceLabel</span>
                                <div class="result-right">
                                    <span class="result-value">@_result.StateDisabilityInsurance.ToString("C")</span>
                                    <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.StateDisability)' title="Show calculation">?</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="result-card result-summary">
                        <div class="result-row">
                            <span>Total Taxes &amp; Withholdings</span>
                            <span class="result-value">@_result.TotalTaxes.ToString("C")</span>
                        </div>
                        <div class="result-row result-net-row">
                            <span class="net-label">Net Pay</span>
                            <span class="result-value net-value">@_result.NetPay.ToString("C")</span>
                        </div>
                    </div>

                    <DoughnutChart Result="_result" />
                </div>
            }

            @if (_resultTab == 1 && _projection != null)
            {
                <!-- Annual projection -->
                <div class="results-scroll">
                    <div class="result-card">
                        <div class="result-card-title">Annualized Amounts (@_projection.PayPeriodsPerYear pay periods/year)</div>
                        <div class="result-row">
                            <span>Gross Pay</span>
                            <span class="result-value">@_projection.AnnualizedGrossPay.ToString("C")</span>
                        </div>
                        @if (_projection.AnnualizedPreTaxDeductions > 0)
                        {
                            <div class="result-row result-sub">
                                <span>Pre-Tax Deductions</span>
                                <span class="result-value sub deduction">-@_projection.AnnualizedPreTaxDeductions.ToString("C")</span>
                            </div>
                        }
                        <div class="result-row">
                            <span>Federal Withholding</span>
                            <span class="result-value">@_projection.AnnualizedFederalWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>State Withholding</span>
                            <span class="result-value">@_projection.AnnualizedStateWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>FICA (SS + Medicare)</span>
                            <span class="result-value">@_projection.AnnualizedFica.ToString("C")</span>
                        </div>
                        <div class="result-row result-net-row">
                            <span class="net-label">Net Pay</span>
                            <span class="result-value net-value">@_projection.AnnualizedNetPay.ToString("C")</span>
                        </div>
                    </div>

                    <div class="result-card">
                        <div class="result-card-title">
                            Projected Year-to-Date — Paycheck @_projection.CurrentPaycheckNumber of @_projection.PayPeriodsPerYear
                        </div>
                        <div class="result-row">
                            <span>Remaining Paychecks</span>
                            <span class="result-value">@_projection.RemainingPaychecks</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Gross Pay</span>
                            <span class="result-value">@_projection.ProjectedYtdGrossPay.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Federal Withholding</span>
                            <span class="result-value">@_projection.ProjectedYtdFederalWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD State Withholding</span>
                            <span class="result-value">@_projection.ProjectedYtdStateWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD FICA</span>
                            <span class="result-value">@_projection.ProjectedYtdFica.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Net Pay</span>
                            <span class="result-value">@_projection.ProjectedYtdNetPay.ToString("C")</span>
                        </div>
                    </div>

                    <div class="result-card @(_projection.OverUnderWithholding > 0 ? "card-refund" : _projection.OverUnderWithholding < 0 ? "card-owe" : "")">
                        <div class="result-card-title">Year-End Estimate</div>
                        <div class="result-row result-sub">
                            <span>Est. Annual Federal Tax Liability</span>
                            <span class="result-value sub">@_projection.EstimatedAnnualFederalLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Est. Annual FICA Liability</span>
                            <span class="result-value sub">@_projection.EstimatedAnnualFicaLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Estimated Total Liability</span>
                            <span class="result-value sub">@_projection.EstimatedTotalLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Annualized Total Withholding</span>
                            <span class="result-value sub">@_projection.AnnualizedTotalWithholding.ToString("C")</span>
                        </div>
                        @if (_projection.OverUnderWithholding > 0)
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Estimated Refund</span>
                                <span class="result-value refund-value">@_projection.OverUnderWithholding.ToString("C")</span>
                            </div>
                        }
                        else if (_projection.OverUnderWithholding < 0)
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Estimated Amount Owed</span>
                                <span class="result-value owe-value">@Math.Abs(_projection.OverUnderWithholding).ToString("C")</span>
                            </div>
                        }
                        else
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Estimated Balance</span>
                                <span class="result-value">$0.00</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div><!-- /results panel -->

</div><!-- /calc-layout -->

<!-- ── SAVED PAYCHECKS & ACCOUNT ─────────────────────────────── -->
<div class="calc-panel history-panel">
    <div class="panel-header">
        <h2>Saved Paychecks &amp; Account</h2>
    </div>
    <div class="history-body">

        <div class="history-list-section">
            <h3 class="history-subtitle">This Session</h3>
            @if (_history.Count == 0)
            {
                <p class="no-fields-msg">Calculated paychecks are saved here for this browser session. Sign in to sync them with the mobile app.</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var item in _history)
                    {
                        <div class="history-row">
                            <div class="history-main">
                                <span class="history-name">@item.Name</span>
                                <span class="history-meta">@item.Input.State &middot; Net @item.Result.NetPay.ToString("C") &middot; Gross @item.Result.GrossPay.ToString("C")</span>
                            </div>
                            <button class="btn-icon btn-danger" @onclick="() => DeletePaycheckAsync(item)" title="Delete">x</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="account-section">
            <h3 class="history-subtitle">Account</h3>
            @if (IsSignedIn)
            {
                <p class="account-email">Signed in as <strong>@Account.Email</strong></p>
                <div class="account-actions">
                    <button class="btn-secondary" @onclick="SyncNowAsync" disabled="@_busy">Sync now</button>
                    <button class="btn-secondary" @onclick="LogoutAsync" disabled="@_busy">Sign out</button>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="_email" autocomplete="username" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" @bind="_password" autocomplete="current-password" />
                </div>
                <div class="account-actions">
                    <button class="btn-calculate account-signin" @onclick="LoginAsync" disabled="@_busy">Sign in</button>
                    <button class="btn-secondary" @onclick="RegisterAsync" disabled="@_busy">Create account</button>
                </div>
                <p class="form-note">Optional. Create an account to sync your saved paychecks between this site and the mobile app.</p>
            }
            @if (_accountError != null)
            {
                <div class="calc-error">@_accountError</div>
            }
            @if (_accountStatus != null)
            {
                <div class="account-status">@_accountStatus</div>
            }
        </div>

    </div><!-- /history-body -->
</div><!-- /history panel -->

@if (_showModal && _modalExplanation != null)
{
    <ExplanationModal Explanation="_modalExplanation" OnClose="CloseModal" />
}

@code {
    private int _inputTab = 0;
    private int _resultTab = 0;

    // Pay & Hours
    private PayFrequency _frequency = PayFrequency.Biweekly;
    private DateOnly _payDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal _hourlyRate = 20m;
    private decimal _regularHours = 80m;
    private decimal _overtimeHours = 0m;
    private decimal _overtimeMultiplier = 1.5m;
    private int _paycheckNumber = 1;
    private decimal _ytdSsWages = 0m;
    private decimal _ytdMedWages = 0m;

    // Calculation mode (standard paycheck vs. gross-up)
    private string _mode = "standard";
    private bool _grossUpMode => _mode == "grossup";
    private decimal _targetNet = 1000m;

    // Federal W-4
    private FederalFilingStatus _fedStatus = FederalFilingStatus.SingleOrMarriedSeparately;
    private bool _step2Checked = false;
    private decimal _step3Credits = 0m;
    private decimal _step4aIncome = 0m;
    private decimal _step4bDeductions = 0m;
    private decimal _step4cExtra = 0m;

    // State
    private UsState _state = UsState.TX;
    private List<StateFieldVm> _stateFields = new();
    private List<string> _stateErrors = new();

    // Deductions
    private List<DeductionVm> _deductions = new();

    // Results
    private PaycheckResult? _result;
    private AnnualProjection? _projection;
    private GrossUpResult? _grossUpResult;
    private string? _calcError;

    // Modal
    private bool _showModal = false;
    private LineExplanation? _modalExplanation;

    // Saved paychecks (session) + account
    private string _paycheckName = "";
    private List<SavedPaycheckDto> _history = new();
    private string _email = "";
    private string _password = "";
    private string? _accountError;
    private string? _accountStatus;
    private bool _busy = false;
    private bool IsSignedIn => Account.IsSignedIn;

    protected override async Task OnInitializedAsync()
    {
        LoadStateFields();
        await RefreshHistoryAsync();
    }

    private void LoadStateFields()
    {
        var schema = SchemaProvider.GetSchema(_state);
        var preserved = _stateFields.ToDictionary(f => f.Key, StringComparer.OrdinalIgnoreCase);
        _stateFields = schema.Select(def =>
        {
            var vm = new StateFieldVm(def);
            if (preserved.TryGetValue(def.Key, out var old))
                vm.RestoreFrom(old);
            return vm;
        }).ToList();
        _stateErrors.Clear();
    }

    private StateInputValues BuildStateValues()
    {
        var d = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _stateFields)
            d[f.Key] = f.GetValue();
        return new StateInputValues(d);
    }

    private async Task Calculate()
    {
        _calcError = null;
        _stateErrors.Clear();

        // Field-level validation
        var hasFieldErrors = false;
        foreach (var f in _stateFields)
        {
            f.Validate();
            if (f.HasError) hasFieldErrors = true;
        }
        if (hasFieldErrors)
        {
            _calcError = "Please fix the highlighted state field errors.";
            _inputTab = 2;
            return;
        }

        var stateValues = BuildStateValues();

        // Cross-field state validation
        if (StateRegistry.IsSupported(_state))
        {
            var errors = StateRegistry.GetCalculator(_state).Validate(stateValues);
            _stateErrors = errors.ToList();
            if (_stateErrors.Count > 0)
            {
                _calcError = _stateErrors.Count == 1 ? _stateErrors[0]
                    : $"{_stateErrors.Count} state validation errors. Check the State tab.";
                _inputTab = 2;
                return;
            }
        }

        var input = new PaycheckInput
        {
            Frequency = _frequency,
            PayDate = _payDate,
            HourlyRate = _hourlyRate,
            RegularHours = _regularHours,
            OvertimeHours = _overtimeHours,
            OvertimeMultiplier = _overtimeMultiplier,
            PaycheckNumber = _paycheckNumber,
            State = _state,
            StateInputValues = stateValues,
            FederalW4 = new FederalW4Input
            {
                FilingStatus = _fedStatus,
                Step2Checked = _step2Checked,
                Step3TaxCredits = _step3Credits,
                Step4aOtherIncome = _step4aIncome,
                Step4bDeductions = _step4bDeductions,
                Step4cExtraWithholding = _step4cExtra
            },
            Deductions = _deductions.Select(d => d.ToDeduction()).ToArray(),
            YtdSocialSecurityWages = _ytdSsWages,
            YtdMedicareWages = _ytdMedWages
        };

        try
        {
            if (_grossUpMode)
            {
                _grossUpResult = GrossUpCalc.Calculate(input, _targetNet);
                _result = _grossUpResult.Paycheck;
                _projection = null;
            }
            else
            {
                _grossUpResult = null;
                _result = Calc.Calculate(input);
                _projection = ProjectionCalc.Calculate(input, _result);
            }
            _resultTab = 0;

            // Save a snapshot of exactly what was calculated, and sync it if signed in.
            await SaveSnapshotAsync(input);
        }
        catch (Exception ex)
        {
            _calcError = $"Calculation error: {ex.Message}";
            _result = null;
            _projection = null;
            _grossUpResult = null;
        }
    }

    private async Task SaveSnapshotAsync(PaycheckInput input)
    {
        if (_result is null) return;

        var isGrossUp = _grossUpResult is not null;
        var name = string.IsNullOrWhiteSpace(_paycheckName)
            ? $"Paycheck {_history.Count + 1}"
            : _paycheckName.Trim();

        var dto = new SavedPaycheckDto
        {
            Name = name,
            UpdatedAtUtc = DateTimeOffset.UtcNow,
            Input = input,
            Result = SavedPaycheckResultMapper.FromResult(
                _result, isGrossUp, isGrossUp ? _grossUpResult!.TargetNetPay : 0m)
        };

        await Store.UpsertAsync(dto);
        await RefreshHistoryAsync();
        if (IsSignedIn) await TrySyncAsync();
    }

    private async Task RefreshHistoryAsync()
    {
        var set = await Store.LoadAsync();
        _history = set.Paychecks.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task DeletePaycheckAsync(SavedPaycheckDto dto)
    {
        await Store.RemoveAsync(dto.Name, DateTimeOffset.UtcNow);
        await RefreshHistoryAsync();
        if (IsSignedIn) await TrySyncAsync();
    }

    private async Task LoginAsync()
    {
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.LoginAsync(_email.Trim(), _password);
        _busy = false;

        if (result.Success)
        {
            Account.Email = _email.Trim();
            _password = "";
            await TrySyncAsync();
        }
        else
        {
            _accountError = result.Error;
        }
    }

    private async Task RegisterAsync()
    {
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.RegisterAsync(_email.Trim(), _password);
        _busy = false;

        if (result.Success)
            await LoginAsync();
        else
            _accountError = result.Error;
    }

    private async Task LogoutAsync()
    {
        await Api.LogoutAsync();
        Account.Email = null;
        _accountStatus = "Signed out. Saved paychecks remain for this session only.";
        _accountError = null;
    }

    private Task SyncNowAsync() => TrySyncAsync();

    private async Task TrySyncAsync()
    {
        _busy = true;
        var outcome = await Sync.SyncAsync();
        _busy = false;

        if (outcome.Success)
        {
            await RefreshHistoryAsync();
            _accountStatus = $"Synced {_history.Count} paycheck(s) at {DateTime.Now:t}.";
            _accountError = null;
        }
        else
        {
            _accountError = outcome.Error;
        }
    }

    private void OnModeChanged()
    {
        // Switching modes clears stale results so the panel doesn't mix views.
        _result = null;
        _projection = null;
        _grossUpResult = null;
        _calcError = null;
    }

    private void OpenExplanation(ExplanationLineKey key)
    {
        _modalExplanation = _result?.Explanation.Get(key);
        if (_modalExplanation != null)
            _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private void AddDeduction() => _deductions.Add(new DeductionVm());
    private void RemoveDeduction(DeductionVm d) => _deductions.Remove(d);

    private static string FrequencyLabel(PayFrequency f) => f switch
    {
        PayFrequency.Weekly       => "Weekly (52x/year)",
        PayFrequency.Biweekly    => "Bi-weekly (26x/year)",
        PayFrequency.Semimonthly => "Semi-monthly (24x/year)",
        PayFrequency.Monthly     => "Monthly (12x/year)",
        PayFrequency.Quarterly   => "Quarterly (4x/year)",
        PayFrequency.Semiannual  => "Semi-annual (2x/year)",
        PayFrequency.Annual      => "Annual (1x/year)",
        PayFrequency.Daily       => "Daily (260x/year)",
        _                        => f.ToString()
    };
}
