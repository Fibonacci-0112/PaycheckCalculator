@page "/{StateSlug}-paycheck-calculator"
@using PaycheckCalc.Blazor.Services
@inject NavigationManager Nav

@if (_info != null)
{
    <HeadContent>
        <title>@_info.Title</title>
        <meta name="description" content="@_info.MetaDescription" />
        <link rel="canonical" href="@_canonical" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@_info.Title" />
        <meta property="og:description" content="@_info.MetaDescription" />
        <meta property="og:url" content="@_canonical" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="@_info.Title" />
        <meta name="twitter:description" content="@_info.MetaDescription" />
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebApplication",
            "name": "@_info.Title",
            "description": "@_info.MetaDescription",
            "url": "@_canonical",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web",
            "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "USD" }
        }
        </script>
    </HeadContent>

    <section class="state-landing-intro">
        <h1>@_info.FullName Paycheck Calculator 2026</h1>
        <p class="state-blurb">@_info.WithholdingBlurb</p>
        <p class="state-cta">
            Enter your pay information below to calculate your exact @_info.FullName take-home pay
            for 2026 — federal taxes, @_info.FullName state withholding, FICA, and deductions all
            computed per the official 2026 withholding tables.
        </p>
    </section>
}
else
{
    <HeadContent>
        <title>Paycheck Calculator — State Not Found</title>
        <meta name="robots" content="noindex" />
    </HeadContent>
    <section class="state-landing-intro state-not-found">
        <h1>State Not Found</h1>
        <p>We don't have a dedicated page for that URL. <a href="/">Use the main paycheck calculator</a> and select your state from the dropdown.</p>
    </section>
}

<Calculator InitialState="_info?.State" />

@code {
    [Parameter] public string StateSlug { get; set; } = "";

    private StateInfo? _info;
    private string _canonical = "";

    protected override void OnParametersSet()
    {
        _info = StateMetadata.GetBySlug(StateSlug);
        _canonical = $"{Nav.BaseUri.TrimEnd('/')}/{StateSlug}-paycheck-calculator";
    }
}
