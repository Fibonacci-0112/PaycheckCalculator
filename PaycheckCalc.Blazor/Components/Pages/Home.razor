@page "/"
@inject NavigationManager Nav

<SeoHead Title="PaycheckCalc — 2026 US Paycheck Calculator"
         Description="Free, accurate US paycheck calculator for 2026. Computes federal income tax (IRS Pub 15-T), FICA, and state withholding for all 50 states + D.C. Includes annual projection and gross-up mode."
         Canonical="@_canonical"
         JsonLd="@_jsonLd" />

<Calculator />

@code {
    private string _canonical = "";
    private string _jsonLd = "";

    protected override void OnInitialized()
    {
        _canonical = Nav.BaseUri.TrimEnd('/') + "/";
        _jsonLd = SeoJsonLd.Build(
            "PaycheckCalc — 2026 US Paycheck Calculator",
            "Free, accurate US paycheck calculator for 2026. Federal taxes, FICA, and state withholding for all 50 states + D.C.",
            _canonical);
    }
}
