<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      EF Core + SQLite for the EfPaycheckRepository / EfAnnualScenarioRepository
      tests. Pinned to the same .NET 10 servicing band as the rest of the
      EF/Identity stack pulled in transitively from PaycheckCalc.Blazor.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaycheckCalc.Core\PaycheckCalc.Core.csproj" />
    <!--
      Tests reference Blazor to exercise EfPaycheckRepository, EfAnnualScenarioRepository,
      EfSessionStateRepository, EfUserPreferencesRepository, and AppDbContext directly
      against an in-memory SQLite database. This pulls in the Identity + ASP.NET Core
      web dependencies, which is fine for testing.
    -->
    <ProjectReference Include="..\PaycheckCalc.Blazor\PaycheckCalc.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PaycheckCalc.Core\Data\ok_ow2_2026_percentage.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ok_ow2_2026_percentage.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\ca_method_b_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ca_method_b_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\us_irs_15t_2026_percentage_automated.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>us_irs_15t_2026_percentage_automated.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\ar_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>ar_withholding_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\co_dr0004_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>co_dr0004_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\connecticut_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>connecticut_withholding_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\Federal2026\federal_1040_brackets_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>federal_1040_brackets_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\pa_eit_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>pa_eit_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\nyc_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>nyc_withholding_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\oh_rita_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>oh_rita_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\oh_cca_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>oh_cca_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\md_county_surtax_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>md_county_surtax_2026.json</Link>
    </None>
    <None Include="..\PaycheckCalc.Core\Data\Schemas\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Schemas\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
