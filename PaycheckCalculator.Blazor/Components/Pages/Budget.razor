@page "/budget"
@* Render mode is set globally on <Routes> in App.razor. *@
@using PaycheckCalculator.Core.Budgeting
@using PaycheckCalculator.Core.Models
@using PaycheckCalculator.Core.Pay
@using PaycheckCalculator.Shared.Budgeting
@using PaycheckCalculator.Shared.Entitlements
@using PaycheckCalculator.Blazor.Services.Export
@inject BudgetCalculator BudgetCalc
@inject BudgetReportCalculator ReportCalc
@inject IEntitlementProvider Entitlements
@inject SessionBudgetStore Store
@inject IJSRuntime JS

<PageTitle>Budget — PaycheckCalculator</PageTitle>

<div class="budget-layout">

    <!-- ── HEADER ──────────────────────────────────────────────── -->
    <div class="budget-header">
        <h2>Monthly Budget</h2>
        <p class="budget-subtitle">Paycheck-driven allocation + expense tracking</p>
    </div>

    <!-- ── INCOME SETUP ────────────────────────────────────────── -->
    <div class="budget-card">
        <h3>Monthly Net Income</h3>
        <div class="form-row">
            <div class="form-group">
                <label>Net Pay per Paycheck ($)</label>
                <input type="number" @bind="_netPayPerPeriod" min="0" step="0.01" />
            </div>
            <div class="form-group">
                <label>Pay Frequency</label>
                <select @bind="_frequency">
                    @foreach (var f in Enum.GetValues<PayFrequency>())
                    {
                        <option value="@f">@FrequencyLabel(f)</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Budgeting Method</label>
                <select @bind="_method">
                    <option value="@BudgetMethod.FiftyThirtyTwenty">50/30/20</option>
                    <option value="@BudgetMethod.ZeroBased">Zero-based</option>
                    <option value="@BudgetMethod.Envelope">Envelope</option>
                    <option value="@BudgetMethod.Custom">Custom</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <button class="btn btn-primary" @onclick="ApplyIncome">Set Income</button>
            <button class="btn btn-secondary" @onclick="ApplyMethodTemplate" disabled="@(_monthlyNetIncome <= 0m)">
                Apply Template
            </button>
        </div>
        @if (_monthlyNetIncome > 0m)
        {
            <p class="income-display">Monthly net income: <strong>@_monthlyNetIncome.ToString("C")</strong></p>
        }
    </div>

    @if (_monthlyNetIncome > 0m && _categories.Count > 0)
    {
        <!-- ── SUMMARY ──────────────────────────────────────────── -->
        <div class="budget-summary-row">
            <div class="summary-chip">
                <span class="chip-label">Budgeted</span>
                <span class="chip-value">@_summary?.TotalBudgeted.ToString("C")</span>
            </div>
            <div class="summary-chip">
                <span class="chip-label">Spent</span>
                <span class="chip-value">@_summary?.TotalSpent.ToString("C")</span>
            </div>
            <div class="summary-chip">
                <span class="chip-label">Remaining</span>
                <span class="chip-value">@_summary?.Remaining.ToString("C")</span>
            </div>
            <div class="summary-chip">
                <span class="chip-label">Unallocated</span>
                <span class="chip-value">@_summary?.Unallocated.ToString("C")</span>
            </div>
            <div class="summary-chip">
                <span class="chip-label">Recurring (mo.)</span>
                <span class="chip-value">@_summary?.TotalRecurring.ToString("C")</span>
            </div>
            <div class="summary-chip">
                <span class="chip-label">Savings goals (mo.)</span>
                <span class="chip-value">@_summary?.TotalSavingsContribution.ToString("C")</span>
            </div>
        </div>

        @if (_method == BudgetMethod.ZeroBased && _summary is not null)
        {
            <div class="zero-based-banner @(_summary.IsFullyAllocated ? "ok" : "warn")">
                @if (_summary.IsFullyAllocated)
                {
                    <span>✓ Every dollar is allocated — your zero-based budget is balanced.</span>
                }
                else
                {
                    <span>@_summary.Unallocated.ToString("C") still to be budgeted. Assign every dollar to reach zero.</span>
                }
            </div>
        }

        <!-- ── CATEGORY BARS ─────────────────────────────────────── -->
        <div class="budget-card">
            <h3>Categories</h3>
            @foreach (var cat in _categorySummaries)
            {
                var pct = cat.Budgeted > 0m
                    ? Math.Min(1.0, (double)(cat.Spent / cat.Budgeted))
                    : 0.0;
                var barColor = pct >= 1.0 ? "var(--color-error, #f44336)"
                             : pct >= 0.8 ? "var(--color-warn, #ff9800)"
                             : "var(--color-ok, #4CAF50)";
                <div class="category-bar">
                    <div class="category-bar-header">
                        <span class="category-name">@cat.Name</span>
                        <span class="category-type @cat.BudgetType.ToString().ToLower()">@cat.BudgetType</span>
                        <span class="category-amounts">
                            @cat.Spent.ToString("C") / @cat.Budgeted.ToString("C")
                        </span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width: @((pct * 100).ToString("F1"))%; background: @barColor"></div>
                    </div>
                    <div class="category-bar-footer">
                        <span>Remaining: @cat.Remaining.ToString("C")</span>
                        <span>Projected month-end: @cat.ProjectedMonthEnd.ToString("C")</span>
                    </div>
                </div>
            }
        </div>

        <!-- ── ADD CATEGORY (user-defined) ───────────────────────── -->
        <div class="budget-card">
            <h3>Add Category</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="_newCatName" placeholder="e.g. Groceries" />
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="_newCatType">
                        @foreach (var t in Enum.GetValues<BudgetType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount</label>
                    <input type="number" @bind="_newCatAmount" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Amount Type</label>
                    <select @bind="_newCatAmountType">
                        <option value="@BudgetAmountType.Dollar">Dollar ($)</option>
                        <option value="@BudgetAmountType.Percentage">Percentage (%)</option>
                    </select>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="AddCategory"
                    disabled="@(string.IsNullOrWhiteSpace(_newCatName))">
                Add Category
            </button>
        </div>

        <!-- ── RECURRING BILLS ───────────────────────────────────── -->
        <div class="budget-card">
            <h3>Recurring Bills</h3>
            @if (_bills.Count > 0)
            {
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Frequency</th>
                            <th class="amount-col">Amount</th>
                            <th class="amount-col">Monthly</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in _bills.OrderBy(b => b.Name))
                        {
                            <tr>
                                <td>@bill.Name</td>
                                <td>@bill.CategoryName</td>
                                <td>@bill.Frequency</td>
                                <td class="amount-col">@bill.Amount.ToString("C")</td>
                                <td class="amount-col">@RecurrencePeriods.MonthlyEquivalent(bill.Amount, bill.Frequency).ToString("C")</td>
                                <td>
                                    <button class="btn-icon" @onclick="() => RemoveBill(bill)" title="Delete bill">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="form-row" style="margin-top:.5rem;">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="_newBillName" placeholder="e.g. Rent" />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select @bind="_newBillCategory">
                        <option value="">— select —</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount ($)</label>
                    <input type="number" @bind="_newBillAmount" min="0.01" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Frequency</label>
                    <select @bind="_newBillFrequency">
                        @foreach (var f in Enum.GetValues<RecurrenceFrequency>())
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="AddBill"
                    disabled="@(string.IsNullOrWhiteSpace(_newBillName) || string.IsNullOrWhiteSpace(_newBillCategory) || _newBillAmount <= 0m)">
                Add Bill
            </button>
        </div>

        <!-- ── SAVINGS GOALS ─────────────────────────────────────── -->
        <div class="budget-card">
            <h3>Savings Goals</h3>
            @if (_goals.Count > 0)
            {
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th class="amount-col">Saved</th>
                            <th class="amount-col">Target</th>
                            <th>By</th>
                            <th class="amount-col">Monthly need</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var goal in _goals.OrderBy(g => g.Name))
                        {
                            var domainGoal = ToDomainGoal(goal);
                            <tr>
                                <td>@goal.Name</td>
                                <td class="amount-col">@goal.CurrentAmount.ToString("C")</td>
                                <td class="amount-col">@goal.TargetAmount.ToString("C")</td>
                                <td>@(goal.TargetDate?.ToString("MMM yyyy") ?? "—")</td>
                                <td class="amount-col">@domainGoal.MonthlyContributionNeeded(DateOnly.FromDateTime(DateTime.Today)).ToString("C")</td>
                                <td>
                                    <button class="btn-icon" @onclick="() => RemoveGoal(goal)" title="Delete goal">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="form-row" style="margin-top:.5rem;">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="_newGoalName" placeholder="e.g. Vacation" />
                </div>
                <div class="form-group">
                    <label>Target ($)</label>
                    <input type="number" @bind="_newGoalTarget" min="0.01" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Saved so far ($)</label>
                    <input type="number" @bind="_newGoalCurrent" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Target date (optional)</label>
                    <input type="date" @bind="_newGoalDate" />
                </div>
            </div>
            <button class="btn btn-primary" @onclick="AddGoal"
                    disabled="@(string.IsNullOrWhiteSpace(_newGoalName) || _newGoalTarget <= 0m)">
                Add Goal
            </button>
        </div>

        <!-- ── ADD EXPENSE ───────────────────────────────────────── -->
        <div class="budget-card">
            <h3>Add Expense</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Category</label>
                    <select @bind="_newTxCategory">
                        <option value="">— select —</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount ($)</label>
                    <input type="number" @bind="_newTxAmount" min="0.01" step="0.01" />
                </div>
            </div>
            <div class="form-group">
                <label>Description (optional)</label>
                <input type="text" @bind="_newTxDescription" />
            </div>
            <button class="btn btn-primary" @onclick="AddTransaction"
                    disabled="@(string.IsNullOrWhiteSpace(_newTxCategory) || _newTxAmount <= 0m)">
                Add Expense
            </button>
        </div>

        <!-- ── TRANSACTION LIST ──────────────────────────────────── -->
        @if (_transactions.Count > 0)
        {
            <div class="budget-card">
                <h3>This Month's Expenses</h3>
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th class="amount-col">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in _transactions.OrderByDescending(t => t.Date))
                        {
                            <tr>
                                <td>@tx.Date.ToString("MMM d")</td>
                                <td>@tx.CategoryName</td>
                                <td class="tx-desc">@tx.Description</td>
                                <td class="amount-col">@tx.Amount.ToString("C")</td>
                                <td>
                                    <button class="btn-icon" @onclick="() => RemoveTransaction(tx)"
                                            title="Delete expense">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (_monthlyNetIncome <= 0m)
    {
        <div class="budget-empty">
            <p>Enter your net pay per paycheck and frequency above, then tap <strong>Set Income</strong>
               to start budgeting. Use <strong>Apply 50/30/20 Rule</strong> for a quick start.</p>
        </div>
    }

    <!-- ── REPORTS (C3 - Pro-gated) ─────────────────────────────── -->
    <div class="budget-card reports-card">
        <h3>Budget Reports &amp; Insights</h3>
        @if (!Entitlements.IsPro)
        {
            <div class="pro-gate">
                <p class="pro-gate-heading">Pro feature</p>
                <p class="pro-gate-body">Budget reports — spend-by-category history and budget-vs-actual trends — are available on the Pro plan.</p>
            </div>
        }
        else
        {
            <div class="form-row" style="margin-bottom:.75rem;">
                <div class="form-group">
                    <label>Months to include</label>
                    <input type="number" @bind="_reportMonthsBack" min="1" max="12" style="max-width:80px;" />
                </div>
                <button class="btn btn-primary" @onclick="GenerateReport"
                        disabled="@(_monthlyNetIncome <= 0m || _categories.Count == 0)">
                    Generate Report
                </button>
            </div>

            @if (_report is not null)
            {
                <!-- Export actions -->
                <div class="form-row" style="margin-bottom:1rem;">
                    <button class="btn btn-secondary" @onclick="DownloadReportCsv">Export CSV</button>
                    <button class="btn btn-secondary" @onclick="DownloadReportPdf">Export PDF</button>
                </div>

                <!-- Budget vs Actual -->
                <h4 class="report-section-heading">Budget vs Actual</h4>
                <table class="tx-table report-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th class="amount-col">Budgeted</th>
                            <th class="amount-col">Actual</th>
                            <th class="amount-col">Variance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pt in _report.BudgetVsActual)
                        {
                            <tr>
                                <td>@pt.Month.ToString("MMM yyyy")</td>
                                <td class="amount-col">@pt.Budgeted.ToString("C")</td>
                                <td class="amount-col">@pt.Actual.ToString("C")</td>
                                <td class="amount-col @(pt.Variance > 0 ? "over-budget" : pt.Variance < 0 ? "under-budget" : "")">
                                    @pt.Variance.ToString("C")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Spend by Category -->
                <h4 class="report-section-heading" style="margin-top:1.25rem;">Spend by Category</h4>
                @foreach (var month in _report.Months)
                {
                    <p class="report-month-label">@month.ToString("MMMM yyyy")</p>
                    <table class="tx-table report-table" style="margin-bottom:.75rem;">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Type</th>
                                <th class="amount-col">Spent</th>
                                <th class="amount-col">Budgeted</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pt in _report.SpendByCategory.Where(p => p.Month == month).OrderBy(p => p.CategoryName))
                            {
                                <tr>
                                    <td>@pt.CategoryName</td>
                                    <td><span class="category-type @pt.BudgetType.ToString().ToLower()">@pt.BudgetType</span></td>
                                    <td class="amount-col @(pt.Spent > pt.Budgeted ? "over-budget" : "")">@pt.Spent.ToString("C")</td>
                                    <td class="amount-col">@pt.Budgeted.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    </div>

</div>

<style>
    .budget-layout { max-width: 800px; margin: 0 auto; padding: 1rem; }
    .budget-header { margin-bottom: 1rem; }
    .budget-subtitle { color: #888; margin: 0; }
    .budget-card { background: #2c2c2c; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
    .budget-card h3 { margin: 0 0 .75rem; font-size: 1rem; color: #eee; }
    .budget-summary-row { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .summary-chip { background: #2c2c2c; border-radius: 8px; padding: .5rem .75rem; flex: 1; min-width: 120px; }
    .chip-label { font-size: .7rem; color: #888; display: block; }
    .chip-value { font-size: 1.1rem; font-weight: bold; color: #fff; }
    .income-display { margin: .5rem 0 0; color: #aaa; }
    .form-row { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: .5rem; align-items: flex-end; }
    .form-group { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 150px; }
    .form-group label { font-size: .75rem; color: #aaa; }
    .form-group input, .form-group select { background: #1a1a1a; border: 1px solid #444; color: #fff;
        border-radius: 4px; padding: .35rem .5rem; }
    .btn { padding: .4rem .9rem; border-radius: 6px; border: none; cursor: pointer; font-size: .85rem; }
    .btn-primary { background: #1976D2; color: #fff; }
    .btn-secondary { background: #388E3C; color: #fff; }
    .btn:disabled { opacity: .5; cursor: default; }
    .category-bar { margin-bottom: .75rem; }
    .category-bar-header { display: flex; align-items: center; gap: .5rem; margin-bottom: .25rem; }
    .category-name { font-weight: bold; color: #eee; flex: 1; }
    .category-type { font-size: .7rem; padding: .15rem .4rem; border-radius: 4px; background: #444; color: #ccc; }
    .category-type.needs { background: #1565C0; }
    .category-type.wants { background: #6A1B9A; }
    .category-type.savings { background: #2E7D32; }
    .category-amounts { font-size: .85rem; color: #aaa; }
    .bar-track { height: 8px; background: #444; border-radius: 4px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 4px; transition: width .3s; }
    .category-bar-footer { display: flex; justify-content: space-between; font-size: .75rem; color: #888; margin-top: .2rem; }
    .tx-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .tx-table th { text-align: left; color: #888; border-bottom: 1px solid #444; padding: .25rem .5rem; }
    .tx-table td { padding: .3rem .5rem; border-bottom: 1px solid #333; color: #ccc; }
    .amount-col { text-align: right; }
    .tx-desc { color: #888; }
    .btn-icon { background: none; border: none; color: #888; cursor: pointer; font-size: .9rem; padding: .1rem .3rem; }
    .btn-icon:hover { color: #f44336; }
    .budget-empty { color: #888; text-align: center; padding: 2rem; }
    .zero-based-banner { border-radius: 8px; padding: .6rem .85rem; margin-bottom: 1rem; font-size: .85rem; }
    .zero-based-banner.ok { background: #1b3a1b; color: #9be29b; }
    .zero-based-banner.warn { background: #3a331b; color: #e2d49b; }
    .reports-card { margin-top: 1.5rem; }
    .pro-gate { text-align: center; padding: 1.5rem 1rem; }
    .pro-gate-heading { font-size: 1.1rem; font-weight: bold; color: #fff; margin: 0 0 .4rem; }
    .pro-gate-body { color: #aaa; margin: 0; }
    .report-section-heading { margin: 0 0 .5rem; font-size: .9rem; color: #ccc; }
    .report-month-label { font-size: .8rem; color: #aaa; margin: .5rem 0 .2rem; }
    .report-table { margin-bottom: .5rem; }
    .over-budget { color: #f44336; }
    .under-budget { color: #4CAF50; }
</style>

@code {
    // ── Income ────────────────────────────────────────────────────────────────
    private decimal _netPayPerPeriod;
    private PayFrequency _frequency = PayFrequency.Biweekly;
    private decimal _monthlyNetIncome;

    // ── Categories / budget definition ────────────────────────────────────────
    private List<BudgetCategory> _categories = [];
    private BudgetMethod _method = BudgetMethod.FiftyThirtyTwenty;
    private string _newCatName = "";
    private BudgetType _newCatType = BudgetType.Needs;
    private decimal _newCatAmount;
    private BudgetAmountType _newCatAmountType = BudgetAmountType.Dollar;

    // ── Summary (computed from calculator) ────────────────────────────────────
    private BudgetSummary? _summary;
    private IReadOnlyList<CategorySummary> _categorySummaries = [];

    // ── Transactions ──────────────────────────────────────────────────────────
    private List<TransactionDto> _transactions = [];
    private string _newTxCategory = "";
    private decimal _newTxAmount;
    private string _newTxDescription = "";

    // ── Recurring bills ─────────────────────────────────────────────────────────
    private List<RecurringBillDto> _bills = [];
    private string _newBillName = "";
    private string _newBillCategory = "";
    private decimal _newBillAmount;
    private RecurrenceFrequency _newBillFrequency = RecurrenceFrequency.Monthly;

    // ── Savings goals ─────────────────────────────────────────────────────────
    private List<SavingsGoalDto> _goals = [];
    private string _newGoalName = "";
    private decimal _newGoalTarget;
    private decimal _newGoalCurrent;
    private DateTime? _newGoalDate;

    private const string BudgetName = "My Budget";

    // ── Reports (C3) ─────────────────────────────────────────────────────────
    private BudgetReport? _report;
    private int _reportMonthsBack = 5;

    [CascadingParameter] private ShellState Shell { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Shell.Set("Budget");

        var budgetSet = await Store.LoadBudgetsAsync();
        var txSet     = await Store.LoadTransactionsAsync();
        var billSet   = await Store.LoadRecurringBillsAsync();
        var goalSet   = await Store.LoadSavingsGoalsAsync();

        var dto = budgetSet.Budgets.FirstOrDefault();
        if (dto is not null)
        {
            _monthlyNetIncome = dto.MonthlyNetIncome;
            _method = dto.Method;
            _categories = dto.Categories.Select(c => new BudgetCategory
            {
                Name = c.Name, BudgetType = c.BudgetType, Amount = c.Amount, AmountType = c.AmountType
            }).ToList();
        }

        _transactions = txSet.Transactions.ToList();
        _bills = billSet.Bills.ToList();
        _goals = goalSet.Goals.ToList();
        RecomputeSummary();
    }

    private void ApplyIncome()
    {
        if (_netPayPerPeriod <= 0m) return;
        _monthlyNetIncome = MonthlyIncomeNormalizer.ToMonthly(_netPayPerPeriod, _frequency);
        RecomputeSummary();
        PersistBudget();
    }

    private void ApplyMethodTemplate()
    {
        if (_monthlyNetIncome <= 0m) return;
        var template = AllocationRules.ForMethod(_method);
        if (template.Count > 0)
        {
            _categories = template.Select(c => new BudgetCategory
            {
                Name = c.Name, BudgetType = c.BudgetType,
                Amount = c.Amount, AmountType = c.AmountType
            }).ToList();
        }
        RecomputeSummary();
        PersistBudget();
    }

    private void AddCategory()
    {
        if (string.IsNullOrWhiteSpace(_newCatName)) return;
        _categories.Add(new BudgetCategory
        {
            Name = _newCatName.Trim(),
            BudgetType = _newCatType,
            Amount = _newCatAmount,
            AmountType = _newCatAmountType
        });
        _newCatName = "";
        _newCatAmount = 0m;
        RecomputeSummary();
        PersistBudget();
    }

    private async Task AddTransaction()
    {
        if (string.IsNullOrWhiteSpace(_newTxCategory) || _newTxAmount <= 0m) return;

        var dto = new TransactionDto
        {
            Id = Guid.NewGuid(),
            BudgetName = "My Budget",
            CategoryName = _newTxCategory,
            Amount = _newTxAmount,
            Date = DateOnly.FromDateTime(DateTime.Today),
            Description = _newTxDescription.Trim(),
            UpdatedAtUtc = DateTimeOffset.UtcNow
        };
        _transactions.Add(dto);
        await Store.UpsertTransactionAsync(dto);

        _newTxCategory = "";
        _newTxAmount = 0m;
        _newTxDescription = "";

        RecomputeSummary();
    }

    private async Task RemoveTransaction(TransactionDto tx)
    {
        _transactions.Remove(tx);
        await Store.RemoveTransactionAsync(tx.Id, DateTimeOffset.UtcNow);
        RecomputeSummary();
    }

    private async Task AddBill()
    {
        if (string.IsNullOrWhiteSpace(_newBillName) || string.IsNullOrWhiteSpace(_newBillCategory) || _newBillAmount <= 0m) return;

        var dto = new RecurringBillDto
        {
            Id = Guid.NewGuid(),
            BudgetName = BudgetName,
            Name = _newBillName.Trim(),
            CategoryName = _newBillCategory,
            Amount = _newBillAmount,
            Frequency = _newBillFrequency,
            UpdatedAtUtc = DateTimeOffset.UtcNow
        };
        _bills.Add(dto);
        await Store.UpsertRecurringBillAsync(dto);

        _newBillName = "";
        _newBillCategory = "";
        _newBillAmount = 0m;
        _newBillFrequency = RecurrenceFrequency.Monthly;
        RecomputeSummary();
    }

    private async Task RemoveBill(RecurringBillDto bill)
    {
        _bills.Remove(bill);
        await Store.RemoveRecurringBillAsync(bill.Id, DateTimeOffset.UtcNow);
        RecomputeSummary();
    }

    private async Task AddGoal()
    {
        if (string.IsNullOrWhiteSpace(_newGoalName) || _newGoalTarget <= 0m) return;

        var dto = new SavingsGoalDto
        {
            Id = Guid.NewGuid(),
            BudgetName = BudgetName,
            Name = _newGoalName.Trim(),
            TargetAmount = _newGoalTarget,
            CurrentAmount = _newGoalCurrent,
            TargetDate = _newGoalDate is { } d ? DateOnly.FromDateTime(d) : null,
            UpdatedAtUtc = DateTimeOffset.UtcNow
        };
        _goals.Add(dto);
        await Store.UpsertSavingsGoalAsync(dto);

        _newGoalName = "";
        _newGoalTarget = 0m;
        _newGoalCurrent = 0m;
        _newGoalDate = null;
        RecomputeSummary();
    }

    private async Task RemoveGoal(SavingsGoalDto goal)
    {
        _goals.Remove(goal);
        await Store.RemoveSavingsGoalAsync(goal.Id, DateTimeOffset.UtcNow);
        RecomputeSummary();
    }

    private static SavingsGoal ToDomainGoal(SavingsGoalDto g) => new()
    {
        Id = g.Id,
        Name = g.Name,
        TargetAmount = g.TargetAmount,
        CurrentAmount = g.CurrentAmount,
        TargetDate = g.TargetDate
    };

    private void RecomputeSummary()
    {
        if (_monthlyNetIncome <= 0m || _categories.Count == 0)
        {
            _summary = null;
            _categorySummaries = [];
            return;
        }

        var budget = new PaycheckCalculator.Core.Budgeting.Budget
        {
            Name = BudgetName,
            MonthlyNetIncome = _monthlyNetIncome,
            Method = _method,
            Categories = _categories
        };

        var domainTransactions = _transactions.Select(t => new BudgetTransaction
        {
            Id = t.Id,
            CategoryName = t.CategoryName,
            Amount = t.Amount,
            Date = t.Date,
            Description = t.Description
        }).ToList();

        var domainBills = _bills.Select(b => new RecurringBill
        {
            Id = b.Id,
            Name = b.Name,
            CategoryName = b.CategoryName,
            Amount = b.Amount,
            Frequency = b.Frequency,
            DueDayOfMonth = b.DueDayOfMonth
        }).ToList();

        var domainGoals = _goals.Select(ToDomainGoal).ToList();

        _summary = BudgetCalc.Calculate(budget, domainTransactions, DateOnly.FromDateTime(DateTime.Today), domainBills, domainGoals);
        _categorySummaries = _summary.Categories;
    }

    private void PersistBudget()
    {
        var dto = new BudgetDto
        {
            Name = BudgetName,
            UpdatedAtUtc = DateTimeOffset.UtcNow,
            MonthlyNetIncome = _monthlyNetIncome,
            Method = _method,
            Categories = _categories.Select(c => new BudgetCategoryDto
            {
                Name = c.Name, BudgetType = c.BudgetType,
                Amount = c.Amount, AmountType = c.AmountType
            }).ToList()
        };
        _ = Store.UpsertBudgetAsync(dto);
    }

    private void GenerateReport()
    {
        if (_monthlyNetIncome <= 0m || _categories.Count == 0) return;
        var months = Math.Clamp(_reportMonthsBack, 1, 12);
        var budget = new PaycheckCalculator.Core.Budgeting.Budget
        {
            Name = BudgetName,
            MonthlyNetIncome = _monthlyNetIncome,
            Method = _method,
            Categories = _categories
        };
        var allTransactions = _transactions.Select(t => new BudgetTransaction
        {
            Id = t.Id, CategoryName = t.CategoryName, Amount = t.Amount,
            Date = t.Date, Description = t.Description
        }).ToList();
        _report = ReportCalc.Compute(budget, allTransactions, DateOnly.FromDateTime(DateTime.Today), months - 1);
    }

    private async Task DownloadReportCsv()
    {
        if (_report is null) return;
        var csv = BudgetReportCsvRenderer.Render(_report);
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        await JS.InvokeVoidAsync("paycheckExport.downloadFile",
            $"budget-report-{DateTime.Today:yyyy-MM}.csv",
            "text/csv",
            Convert.ToBase64String(bytes));
    }

    private async Task DownloadReportPdf()
    {
        if (_report is null) return;
        var pdf = BudgetReportPdfRenderer.Render(_report);
        await JS.InvokeVoidAsync("paycheckExport.downloadFile",
            $"budget-report-{DateTime.Today:yyyy-MM}.pdf",
            "application/pdf",
            Convert.ToBase64String(pdf));
    }

    private static string FrequencyLabel(PayFrequency f) => f switch
    {
        PayFrequency.Weekly       => "Weekly (52×/year)",
        PayFrequency.Biweekly     => "Biweekly (26×/year)",
        PayFrequency.Semimonthly  => "Semimonthly (24×/year)",
        PayFrequency.Monthly      => "Monthly (12×/year)",
        PayFrequency.Quarterly    => "Quarterly (4×/year)",
        PayFrequency.Semiannual   => "Semiannual (2×/year)",
        PayFrequency.Annual       => "Annual (1×/year)",
        PayFrequency.Daily        => "Daily (260×/year)",
        PayFrequency.Weekly53     => "Weekly 53-period year",
        PayFrequency.Biweekly27   => "Biweekly 27-period year",
        _                         => f.ToString()
    };
}
