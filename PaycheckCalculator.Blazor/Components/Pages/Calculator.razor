    private string ExportFileName(string extension) => $"{Sanitize(_exportFileName, "Paycheck-Summary")}.{extension}";

    private string ComparisonFileName(string extension) =>
        $"{Sanitize($"Comparison-{_compareAName}-vs-{_compareBName}", "Comparison")}.{extension}";

    /// <summary>Turns a user-supplied label into a file-system-safe base name.</summary>
    private static string Sanitize(string? baseName, string fallback)
    {
        if (string.IsNullOrWhiteSpace(baseName)) return fallback;
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        var sb = new StringBuilder(baseName.Length);
        foreach (var ch in baseName.Trim())
            sb.Append(Array.IndexOf(invalid, ch) >= 0 ? '-' : ch);
        var cleaned = sb.ToString().Trim();
        return string.IsNullOrEmpty(cleaned) ? fallback : cleaned;
    }

    private void AddDeduction() => _deductions.Add(new DeductionVm());
    private void RemoveDeduction(DeductionVm d) => _deductions.Remove(d);

    private static string FrequencyLabel(PayFrequency f) => f switch
    {
        PayFrequency.Weekly       => "Weekly (52x/year)",
        PayFrequency.Biweekly    => "Bi-weekly (26x/year)",
        PayFrequency.Semimonthly => "Semi-monthly (24x/year)",
        PayFrequency.Monthly     => "Monthly (12x/year)",
        PayFrequency.Quarterly   => "Quarterly (4x/year)",
        PayFrequency.Semiannual  => "Semi-annual (2x/year)",
        PayFrequency.Annual      => "Annual (1x/year)",
        PayFrequency.Daily       => "Daily (260x/year)",
        PayFrequency.Weekly53    => "Weekly 53 (53x/year)",
        PayFrequency.Biweekly27  => "Bi-weekly 27 (27x/year)",
        _                        => f.ToString()
    };
