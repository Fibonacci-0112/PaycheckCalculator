@* Render mode is set globally on <Routes> in App.razor; declaring it again here
   would conflict with the ancestor's mode. *@
@using System.Text
@using PaycheckCalculator.Blazor.Models
@using PaycheckCalculator.Blazor.Services.Export
@using PaycheckCalculator.Shared.Budgeting
@inject IJSRuntime JS
@inject PayCalculator Calc
@inject AnnualProjectionCalculator ProjectionCalc
@inject GrossUpCalculator GrossUpCalc
@inject BonusCalculator BonusCalc
@inject SelfEmploymentCalculator SelfEmpCalc
@inject StateCalculatorRegistry StateRegistry
@inject IStateSchemaProvider SchemaProvider
@inject SessionPaycheckStore Store
@inject SessionBudgetStore BudgetStore
@inject CircuitAccountSession Account
@inject PaycheckApiClient Api
@inject PaycheckSyncService Sync

<div class="calc-page">

@if (_result != null && _projection != null && _grossUpResult == null)
{
    <HeroSummary Result="_result"
                 Projection="_projection"
                 FrequencyText="@FrequencyLabel(_frequency)"
                 Subtitle="@HeroSubtitle()" />

    <KpiRow Projection="_projection"
            State="@_state.ToString()"
            PayBasisLabel="@PayBasisLabel()" />
}

<div class="calc-layout">

  <div class="calc-stack">
    <!-- ── INPUTS PANEL ─────────────────────────────────────── -->
    <div class="calc-panel">
        <div class="panel-header">
            <h2>Inputs</h2>
        </div>

        <div class="tab-bar">
            <button class="tab-btn @(_inputTab == 0 ? "active" : "")" data-testid="input-tab-pay-hours" @onclick="() => _inputTab = 0">Pay &amp; Hours</button>
            <button class="tab-btn @(_inputTab == 1 ? "active" : "")" data-testid="input-tab-federal" @onclick="() => _inputTab = 1">Federal W-4</button>
            <button class="tab-btn @(_inputTab == 2 ? "active" : "")" @onclick="() => _inputTab = 2">State</button>
            <button class="tab-btn @(_inputTab == 3 ? "active" : "")" @onclick="() => _inputTab = 3">Deductions</button>
        </div>

        <div class="tab-content">

            @if (_inputTab == 0)
            {
                <!-- Pay & Hours -->
                <div class="form-group">
                    <label>Pay Frequency</label>
                    <select @bind="_frequency">
                        @foreach (var f in Enum.GetValues<PayFrequency>())
                        {
                            <option value="@f">@FrequencyLabel(f)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Calculation Mode</label>
                    <select @bind="_mode" @bind:after="OnModeChanged">
                        <option value="standard">Standard paycheck (gross &rarr; net)</option>
                        <option value="grossup">Gross-up (net &rarr; required gross)</option>
                        <option value="bonus">Bonus / supplemental wage</option>
                        <option value="selfemployment">Self-employment / 1099</option>
                    </select>
                </div>

                @if (_mode == "standard")
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Hourly Rate ($)</label>
                            <input type="number" data-testid="hourly-rate" @bind="_hourlyRate" min="0" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Regular Hours</label>
                            <input type="number" data-testid="regular-hours" @bind="_regularHours" min="0" step="0.5" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Overtime Hours</label>
                            <input type="number" data-testid="overtime-hours" @bind="_overtimeHours" min="0" step="0.5" />
                        </div>
                        <div class="form-group">
                            <label>OT Multiplier</label>
                            <input type="number" @bind="_overtimeMultiplier" min="1" step="0.25" />
                        </div>
                    </div>
                }
                else if (_grossUpMode)
                {
                    <div class="form-group">
                        <label>Desired Net Pay &mdash; take-home this period ($)</label>
                        <input type="number" @bind="_targetNet" min="0" step="0.01" />
                    </div>
                    <p class="form-note">Enter the exact take-home amount. Gross-up finds the gross pay that nets it after taxes and deductions &mdash; used for net bonuses and relocation payments.</p>
                }
                else if (_selfEmpMode)
                {
                    <div class="form-group">
                        <label>Net Self-Employment Income &mdash; annual ($)</label>
                        <input type="number" @bind="_selfEmpEarnings" min="0" step="0.01" />
                    </div>
                    <p class="form-note">Enter your annual net profit (Schedule C: gross receipts minus business expenses). Self-employment tax is 15.3% &mdash; 12.4% Social Security (to the $184,500 cap) + 2.9% Medicare &mdash; on 92.35% of it. Pick your state on the State tab for an income-tax estimate. There is no separate state self-employment tax; the W-4 and deductions don't apply.</p>
                }
                else
                {
                    <div class="form-group">
                        <label>Bonus Amount ($)</label>
                        <input type="number" @bind="_bonusAmount" min="0" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Prior Supplemental Wages This Year ($)</label>
                        <input type="number" @bind="_ytdSupplementalWages" min="0" step="0.01" />
                    </div>
                    <p class="form-note">Bonuses are withheld at the federal flat supplemental rate &mdash; 22% (37% on cumulative supplemental wages over $1,000,000) &mdash; plus FICA and your state's supplemental rate. Pick your work state on the State tab. Federal W-4 and deductions don't apply.</p>
                }
                @if (!_bonusMode && !_selfEmpMode)
                {
                    <div class="form-group">
                        <label>Paycheck # This Year</label>
                        <input type="number" @bind="_paycheckNumber" min="1" max="365" />
                    </div>
                }
                <div class="form-section-title">Year-to-Date Wages (for FICA caps)</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>YTD Social Security Wages ($)</label>
                        <input type="number" @bind="_ytdSsWages" min="0" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>YTD Medicare Wages ($)</label>
                        <input type="number" @bind="_ytdMedWages" min="0" step="0.01" />
                    </div>
                </div>
            }

            @if (_inputTab == 1)
            {
                <!-- Federal W-4 -->
                <div class="form-group">
                    <label>Filing Status</label>
                    <div class="segmented">
                        <button type="button" class="segment @(_fedStatus == FederalFilingStatus.SingleOrMarriedSeparately ? "on" : "")"
                                @onclick="() => _fedStatus = FederalFilingStatus.SingleOrMarriedSeparately"
                                title="Single / Married Filing Separately">Single</button>
                        <button type="button" class="segment @(_fedStatus == FederalFilingStatus.MarriedFilingJointly ? "on" : "")"
                                @onclick="() => _fedStatus = FederalFilingStatus.MarriedFilingJointly">Married Joint</button>
                        <button type="button" class="segment @(_fedStatus == FederalFilingStatus.HeadOfHousehold ? "on" : "")"
                                @onclick="() => _fedStatus = FederalFilingStatus.HeadOfHousehold">Head of HH</button>
                    </div>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="step2" @bind="_step2Checked" />
                    <label for="step2">Step 2: Multiple jobs / spouse also works</label>
                </div>
                <p class="form-note">Checking Step 2 halves the standard deduction, increasing withholding for dual-income households.</p>
                <div class="form-group">
                    <label>Step 3 — Tax Credits (annual $)</label>
                    <input type="number" @bind="_step3Credits" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(a) — Other Income (annual $)</label>
                    <input type="number" @bind="_step4aIncome" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(b) — Deductions (annual $)</label>
                    <input type="number" @bind="_step4bDeductions" min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Step 4(c) — Extra Withholding (per paycheck $)</label>
                    <input type="number" @bind="_step4cExtra" min="0" step="0.01" />
                </div>
            }

            @if (_inputTab == 2)
            {
                <!-- State -->
                <div class="form-group">
                    <label>State</label>
                    <select @bind="_state" @bind:after="LoadStateFields">
                        @foreach (var s in StateRegistry.SupportedStates)
                        {
                            <option value="@s">@s.ToString()</option>
                        }
                    </select>
                </div>

                @if (_stateFields.Count == 0)
                {
                    <p class="no-fields-msg">No additional withholding inputs required for @_state.</p>
                }
                else
                {
                    @foreach (var field in _stateFields)
                    {
                        <div class="form-group @(field.HasError ? "has-error" : "")">
                            <label>@field.Label</label>
                            @if (field.FieldType == StateFieldType.Picker)
                            {
                                <select @bind="field.SelectedOption">
                                    @if (field.Options != null)
                                    {
                                        @foreach (var opt in field.Options)
                                        {
                                            <option value="@opt">@opt</option>
                                        }
                                    }
                                </select>
                            }
                            else if (field.FieldType == StateFieldType.Toggle)
                            {
                                <div class="toggle-row">
                                    <input type="checkbox" @bind="field.BoolValue" />
                                    <span class="toggle-label">@(field.BoolValue ? "Yes" : "No")</span>
                                </div>
                            }
                            else
                            {
                                <input type="number"
                                       @bind="field.StringValue"
                                       step="@(field.FieldType == StateFieldType.Integer ? "1" : "0.01")" />
                            }
                            @if (field.HasError)
                            {
                                <span class="field-error">@field.ErrorMessage</span>
                            }
                        </div>
                    }
                }

                @if (_stateErrors.Count > 0)
                {
                    <div class="state-validation-errors">
                        @foreach (var err in _stateErrors)
                        {
                            <p>@err</p>
                        }
                    </div>
                }
            }

            @if (_inputTab == 3)
            {
                <!-- Deductions -->
                @if (_deductions.Count == 0)
                {
                    <p class="no-fields-msg">No deductions added. Use pre-tax deductions (401k, HSA) or post-tax deductions.</p>
                }

                @foreach (var ded in _deductions.ToList())
                {
                    <div class="deduction-card">
                        <div class="deduction-header">
                            <input type="text" @bind="ded.Name"
                                   @oninput="@(() => ded.NameError = false)"
                                   placeholder="Name (e.g. 401k, Health)"
                                   class="ded-name @(ded.NameError ? "input-error" : "")" />
                            @if (ded.NameError) { <span class="field-error">Name is required</span> }
                            <button class="btn-icon btn-danger" @onclick="() => RemoveDeduction(ded)" title="Remove">x</button>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Amount</label>
                                <input type="number" @bind="ded.Amount" min="0" step="0.01" />
                            </div>
                            <div class="form-group">
                                <label>Amount Type</label>
                                <select @bind="ded.AmountType">
                                    <option value="@DeductionAmountType.Dollar">Dollar ($)</option>
                                    <option value="@DeductionAmountType.Percentage">Percentage (%)</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Deduction Type</label>
                            <select @bind="ded.Type">
                                <option value="@DeductionType.PreTax">Pre-Tax</option>
                                <option value="@DeductionType.PostTax">Post-Tax</option>
                            </select>
                        </div>
                        <div class="deduction-flags">
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesFederalTaxableWages" />
                                Reduces Federal Taxable Wages
                            </label>
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesStateTaxableWages" />
                                Reduces State Taxable Wages
                            </label>
                            <label class="flag-label">
                                <input type="checkbox" @bind="ded.ReducesFicaWages" />
                                Reduces FICA Wages
                            </label>
                        </div>
                    </div>
                }

                <button class="btn-secondary" @onclick="AddDeduction">+ Add Deduction</button>
            }

        </div><!-- /tab-content -->

        <div class="action-bar">
            <input type="text" class="paycheck-name-input" @bind="_paycheckName" placeholder="Paycheck name (optional)" />
            <button class="btn-calculate" data-testid="calculate" @onclick="Calculate">Calculate</button>
            @if (_calcError != null)
            {
                <div class="calc-error">@_calcError</div>
            }
        </div>

    </div><!-- /inputs panel -->

    <SetupChecklist HasPayEntered="@HasPayEntered()"
                    StateComplete="@(_stateErrors.Count == 0)"
                    HasDeductions="@(_deductions.Count > 0)"
                    HasResult="@(_result != null || _bonusResult != null || _selfEmpResult != null)"
                    HasSaved="@(_history.Count > 0)"
                    StateName="@_state.ToString()" />
  </div><!-- /left column -->

  <div class="calc-stack">
    @if (_result != null)
    {
        <!-- ── INCOME ALLOCATION ─────────────────────────────── -->
        <div class="calc-panel no-print">
            <div class="panel-header">
                <span class="card-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" /><path d="M12 3v9l6.4 4" />
                    </svg>
                </span>
                <h2>Income Allocation Breakdown</h2>
                <a class="card-link" href="#result-detail">View details &rarr;</a>
            </div>
            <DoughnutChart Result="_result" />
        </div>
    }

    <!-- ── RESULTS PANEL ─────────────────────────────────────── -->
    <div class="calc-panel results-outer" id="result-detail">
        <div class="panel-header results-header">
            <h2>Results</h2>
            @if (_result != null || _bonusResult != null || _selfEmpResult != null)
            {
                <div class="results-actions no-print">
                    <input type="text" class="export-name-input" @bind="_exportFileName"
                           placeholder="File name" title="Name for exported files" aria-label="Export file name" />
                    <button class="btn-export" @onclick="ExportCsvAsync" title="Download results as CSV">CSV</button>
                    <button class="btn-export" @onclick="ExportPdfAsync" title="Download results as PDF">PDF</button>
                    <button class="btn-export" @onclick="PrintAsync" title="Print results">Print</button>
                    <button class="btn-export" @onclick="OpenAccuracySources" title="View the tax-rule citations behind these results">Sources</button>
                </div>
            }
        </div>

        @if (_result == null && _bonusResult == null && _selfEmpResult == null)
        {
            <div class="results-placeholder">
                <svg class="placeholder-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="24" cy="24" r="21"/>
                    <line x1="24" y1="10" x2="24" y2="14.5"/>
                    <line x1="24" y1="33.5" x2="24" y2="38"/>
                    <path d="M18.5 18a6 6 0 0 1 11 0c0 3.5-3 5-5.5 6.5-2.5 1.5-5.5 3-5.5 6.5a6 6 0 0 0 11 0"/>
                </svg>
                <p>Enter your paycheck information and click <strong>Calculate</strong> to see your results.</p>
            </div>
        }
        else if (_bonusResult != null)
        {
            <div class="results-scroll">
                <div class="result-card card-refund">
                    <div class="result-card-title">Bonus / Supplemental Wage</div>
                    <div class="result-row">
                        <span>Bonus Amount</span>
                        <div class="result-right">
                            <span class="result-value">@_bonusResult.BonusAmount.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.GrossPay)' title="Show calculation">?</button>
                        </div>
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-title">Tax Withholdings</div>
                    <div class="result-row">
                        <span>Federal (supplemental @($"{PaycheckCalculator.Core.Tax.Federal.FederalSupplementalCalculator.FlatRate:P0}"))</span>
                        <div class="result-right">
                            <span class="result-value">-@_bonusResult.FederalWithholding.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.FederalWithholding)' title="Show calculation">?</button>
                        </div>
                    </div>
                    <div class="result-row">
                        <span>Social Security</span>
                        <div class="result-right">
                            <span class="result-value">-@_bonusResult.SocialSecurityWithholding.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.SocialSecurity)' title="Show calculation">?</button>
                        </div>
                    </div>
                    <div class="result-row">
                        <span>Medicare</span>
                        <div class="result-right">
                            <span class="result-value">-@_bonusResult.MedicareWithholding.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.Medicare)' title="Show calculation">?</button>
                        </div>
                    </div>
                    @if (_bonusResult.AdditionalMedicareWithholding > 0)
                    {
                        <div class="result-row">
                            <span>Additional Medicare</span>
                            <div class="result-right">
                                <span class="result-value">-@_bonusResult.AdditionalMedicareWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.AdditionalMedicare)' title="Show calculation">?</button>
                            </div>
                        </div>
                    }
                    @if (!_bonusResult.StateUsesRegularMethod)
                    {
                        <div class="result-row">
                            <span>@_bonusResult.State State</span>
                            <div class="result-right">
                                <span class="result-value">-@_bonusResult.StateWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenBonusExplanation(ExplanationLineKey.StateWithholding)' title="Show calculation">?</button>
                            </div>
                        </div>
                    }
                </div>

                @if (_bonusResult.StateUsesRegularMethod)
                {
                    <div class="result-card">
                        <div class="result-card-title">@_bonusResult.State State Tax</div>
                        <p class="form-note">@_bonusResult.StateWithholdingDescription The net below is before state income tax.</p>
                    </div>
                }

                <div class="result-card">
                    <div class="result-row">
                        <span>Total Withholding</span>
                        <span class="result-value">-@_bonusResult.TotalTaxes.ToString("C")</span>
                    </div>
                    <div class="result-row result-net-row">
                        <span class="net-label">@(_bonusResult.StateUsesRegularMethod ? "Net Bonus (before state tax)" : "Net Bonus")</span>
                        <span class="result-value net-value">@_bonusResult.NetBonus.ToString("C")</span>
                    </div>
                </div>
                <div class="result-card">
                    <div class="result-card-title">Assumptions &amp; Exclusions</div>
                    @foreach (var note in _bonusResult.AccuracyNotes)
                    {
                        <p class="form-note"><strong>@note.Title:</strong> @note.Description</p>
                    }
                </div>
            </div>
        }
        else if (_selfEmpResult != null)
        {
            <div class="results-scroll">
                <div class="result-card card-refund">
                    <div class="result-card-title">Self-Employment / 1099 (annual)</div>
                    <div class="result-row">
                        <span>Net Self-Employment Income</span>
                        <div class="result-right">
                            <span class="result-value">@_selfEmpResult.AnnualNetEarnings.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.GrossPay)' title="Show calculation">?</button>
                        </div>
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-title">Self-Employment Tax (15.3%)</div>
                    <div class="result-row">
                        <span>Net Earnings Subject to SE Tax (92.35%)</span>
                        <div class="result-right">
                            <span class="result-value">@_selfEmpResult.NetEarningsSubjectToSeTax.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.FicaTaxableWages)' title="Show calculation">?</button>
                        </div>
                    </div>
                    <div class="result-row">
                        <span>Social Security (12.4%)</span>
                        <div class="result-right">
                            <span class="result-value">-@_selfEmpResult.SocialSecurityTax.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.SocialSecurity)' title="Show calculation">?</button>
                        </div>
                    </div>
                    <div class="result-row">
                        <span>Medicare (2.9%)</span>
                        <div class="result-right">
                            <span class="result-value">-@_selfEmpResult.MedicareTax.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.Medicare)' title="Show calculation">?</button>
                        </div>
                    </div>
                    @if (_selfEmpResult.AdditionalMedicareTax > 0)
                    {
                        <div class="result-row">
                            <span>Additional Medicare (0.9%)</span>
                            <div class="result-right">
                                <span class="result-value">-@_selfEmpResult.AdditionalMedicareTax.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.AdditionalMedicare)' title="Show calculation">?</button>
                            </div>
                        </div>
                    }
                    <div class="result-row result-sub">
                        <span>Total Self-Employment Tax</span>
                        <div class="result-right">
                            <span class="result-value">-@_selfEmpResult.SelfEmploymentTax.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.FederalWithholding)' title="Show calculation">?</button>
                        </div>
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-title">Estimated State Income Tax (@_selfEmpResult.State)</div>
                    <div class="result-row">
                        <span>@_selfEmpResult.State income tax</span>
                        <div class="result-right">
                            <span class="result-value">-@_selfEmpResult.StateIncomeTax.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.StateWithholding)' title="Show calculation">?</button>
                        </div>
                    </div>
                    <p class="form-note">No U.S. state levies a separate self-employment tax &mdash; self-employment income is taxed as ordinary state income (estimate; before any federal income tax).</p>
                </div>

                <div class="result-card">
                    <div class="result-row">
                        <span>Total Estimated Tax</span>
                        <span class="result-value">-@_selfEmpResult.TotalTax.ToString("C")</span>
                    </div>
                    <div class="result-row result-net-row">
                        <span class="net-label">Take-Home (before federal income tax)</span>
                        <div class="result-right">
                            <span class="result-value net-value">@_selfEmpResult.TakeHome.ToString("C")</span>
                            <button class="btn-info" @onclick='() => OpenSelfEmpExplanation(ExplanationLineKey.NetPay)' title="Show calculation">?</button>
                        </div>
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-title">Quarterly Estimated Payments (Form 1040-ES)</div>
                    <table class="compare-table">
                        <thead>
                            <tr>
                                <th class="compare-metric">Quarter</th>
                                <th class="compare-num">Due</th>
                                <th class="compare-num">Federal</th>
                                <th class="compare-num">State</th>
                                <th class="compare-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in _selfEmpResult.QuarterlyEstimates)
                            {
                                <tr>
                                    <td class="compare-metric">@q.Label</td>
                                    <td class="compare-num">@q.DueDate.ToString("MMM d, yyyy")</td>
                                    <td class="compare-num">@q.FederalAmount.ToString("C")</td>
                                    <td class="compare-num">@q.StateAmount.ToString("C")</td>
                                    <td class="compare-num">@q.TotalAmount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="form-note">Equal installments of your estimated annual tax. The federal portion is paid to the IRS; the state portion, when shown, goes to your state. Most states use these same due dates.</p>
                </div>
                <div class="result-card">
                    <div class="result-card-title">Assumptions &amp; Exclusions</div>
                    @foreach (var note in _selfEmpResult.AccuracyNotes)
                    {
                        <p class="form-note"><strong>@note.Title:</strong> @note.Description</p>
                    }
                </div>
            </div>
        }
        else if (_result != null)
        {
            @if (_grossUpResult == null)
            {
                <div class="tab-bar no-print">
                    <button class="tab-btn @(_resultTab == 0 ? "active" : "")" data-testid="result-tab-per-paycheck" @onclick="() => _resultTab = 0">Per Paycheck</button>
                    <button class="tab-btn @(_resultTab == 1 ? "active" : "")" data-testid="result-tab-annual" @onclick="() => _resultTab = 1">Annual</button>
                </div>
            }

            @if (_resultTab == 0 || _grossUpResult != null)
            {
                <!-- Period results -->
                <div class="results-scroll">
                    @if (_grossUpResult != null)
                    {
                        <div class="result-card card-refund">
                            <div class="result-card-title">Gross-Up Result</div>
                            <div class="result-row">
                                <span>Desired Net Pay (take-home)</span>
                                <span class="result-value">@_grossUpResult.TargetNetPay.ToString("C")</span>
                            </div>
                            <div class="result-row">
                                <span>Taxes &amp; Deductions Covered</span>
                                <span class="result-value">@_grossUpResult.GrossUpCost.ToString("C")</span>
                            </div>
                            <div class="result-row result-net-row">
                                <span class="net-label">Required Gross Pay</span>
                                <span class="result-value net-value">@_grossUpResult.GrossUpPay.ToString("C")</span>
                            </div>
                            @if (!_grossUpResult.Converged)
                            {
                                <div class="result-row">
                                    <span class="result-value deduction">Could not reach the target net with these inputs.</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="result-card">
                        <div class="result-card-title">Income</div>
                        <div class="result-row">
                            <span>Gross Pay</span>
                            <div class="result-right">
                                <span class="result-value">@_result.GrossPay.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.GrossPay)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row result-sub">
                            <span>Federal Taxable Income</span>
                            <span class="result-value sub">@_result.FederalTaxableIncome.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>FICA Taxable Wages</span>
                            <span class="result-value sub">@_result.FicaTaxableWages.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>@_result.State Taxable Wages</span>
                            <span class="result-value sub">@_result.StateTaxableWages.ToString("C")</span>
                        </div>
                    </div>

                    @if (_result.PreTaxDeductions > 0 || _result.PostTaxDeductions > 0)
                    {
                        <div class="result-card">
                            <div class="result-card-title">Deductions</div>
                            @if (_result.PreTaxDeductions > 0)
                            {
                                <div class="result-row">
                                    <span>Pre-Tax Deductions</span>
                                    <span class="result-value deduction">-@_result.PreTaxDeductions.ToString("C")</span>
                                </div>
                            }
                            @if (_result.PostTaxDeductions > 0)
                            {
                                <div class="result-row">
                                    <span>Post-Tax Deductions</span>
                                    <span class="result-value deduction">-@_result.PostTaxDeductions.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="result-card">
                        <div class="result-card-title">Tax Withholdings</div>
                        <div class="result-row">
                            <span>Federal Income Tax</span>
                            <div class="result-right">
                                <span class="result-value">@_result.FederalWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.FederalWithholding)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row">
                            <span>Social Security (6.2%)</span>
                            <div class="result-right">
                                <span class="result-value">@_result.SocialSecurityWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.SocialSecurity)' title="Show calculation">?</button>
                            </div>
                        </div>
                        <div class="result-row">
                            <span>Medicare (1.45%)</span>
                            <div class="result-right">
                                <span class="result-value">@_result.MedicareWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.Medicare)' title="Show calculation">?</button>
                            </div>
                        </div>
                        @if (_result.AdditionalMedicareWithholding > 0)
                        {
                            <div class="result-row">
                                <span>Additional Medicare (0.9%)</span>
                                <div class="result-right">
                                    <span class="result-value">@_result.AdditionalMedicareWithholding.ToString("C")</span>
                                    <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.AdditionalMedicare)' title="Show calculation">?</button>
                                </div>
                            </div>
                        }
                        <div class="result-row">
                            <span>@_result.State State Income Tax</span>
                            <div class="result-right">
                                <span class="result-value">@_result.StateWithholding.ToString("C")</span>
                                <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.StateWithholding)' title="Show calculation">?</button>
                            </div>
                        </div>
                        @if (_result.StateDisabilityInsurance > 0)
                        {
                            <div class="result-row">
                                <span>@_result.StateDisabilityInsuranceLabel</span>
                                <div class="result-right">
                                    <span class="result-value">@_result.StateDisabilityInsurance.ToString("C")</span>
                                    <button class="btn-info" @onclick='() => OpenExplanation(ExplanationLineKey.StateDisability)' title="Show calculation">?</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="result-card result-summary">
                        <div class="result-row">
                            <span>Total Taxes &amp; Withholdings</span>
                            <span class="result-value">@_result.TotalTaxes.ToString("C")</span>
                        </div>
                        <div class="result-row result-net-row">
                            <span class="net-label">Net Pay</span>
                            <span class="result-value net-value" data-testid="net-pay">@_result.NetPay.ToString("C")</span>
                        </div>
                    </div>

                </div>
            }

            @if (_resultTab == 1 && _projection != null)
            {
                <!-- Annual projection -->
                <div class="results-scroll">
                    <div class="result-card">
                        <div class="result-card-title">Annualized Amounts (@_projection.PayPeriodsPerYear pay periods/year)</div>
                        <div class="result-row">
                            <span>Gross Pay</span>
                            <span class="result-value">@_projection.AnnualizedGrossPay.ToString("C")</span>
                        </div>
                        @if (_projection.AnnualizedPreTaxDeductions > 0)
                        {
                            <div class="result-row result-sub">
                                <span>Pre-Tax Deductions</span>
                                <span class="result-value sub deduction">-@_projection.AnnualizedPreTaxDeductions.ToString("C")</span>
                            </div>
                        }
                        <div class="result-row">
                            <span>Federal Withholding</span>
                            <span class="result-value">@_projection.AnnualizedFederalWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>State Withholding</span>
                            <span class="result-value">@_projection.AnnualizedStateWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>FICA (SS + Medicare)</span>
                            <span class="result-value">@_projection.AnnualizedFica.ToString("C")</span>
                        </div>
                        <div class="result-row result-net-row">
                            <span class="net-label">Net Pay</span>
                            <span class="result-value net-value" data-testid="annual-net-pay">@_projection.AnnualizedNetPay.ToString("C")</span>
                        </div>
                    </div>

                    <div class="result-card">
                        <div class="result-card-title">
                            Projected Year-to-Date — Paycheck @_projection.CurrentPaycheckNumber of @_projection.PayPeriodsPerYear
                        </div>
                        <div class="result-row">
                            <span>Remaining Paychecks</span>
                            <span class="result-value">@_projection.RemainingPaychecks</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Gross Pay</span>
                            <span class="result-value">@_projection.ProjectedYtdGrossPay.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Federal Withholding</span>
                            <span class="result-value">@_projection.ProjectedYtdFederalWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD State Withholding</span>
                            <span class="result-value">@_projection.ProjectedYtdStateWithholding.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD FICA</span>
                            <span class="result-value">@_projection.ProjectedYtdFica.ToString("C")</span>
                        </div>
                        <div class="result-row">
                            <span>Projected YTD Net Pay</span>
                            <span class="result-value">@_projection.ProjectedYtdNetPay.ToString("C")</span>
                        </div>
                    </div>

                    <div class="result-card @(_projection.OverUnderWithholding > 0 ? "card-refund" : _projection.OverUnderWithholding < 0 ? "card-owe" : "")">
                        <div class="result-card-title">Year-End Estimate</div>
                        <div class="result-row result-sub">
                            <span>Est. Annual Federal Tax Liability</span>
                            <span class="result-value sub">@_projection.EstimatedAnnualFederalLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Est. Annual FICA Liability</span>
                            <span class="result-value sub">@_projection.EstimatedAnnualFicaLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Estimated Total Liability</span>
                            <span class="result-value sub">@_projection.EstimatedTotalLiability.ToString("C")</span>
                        </div>
                        <div class="result-row result-sub">
                            <span>Annualized Total Withholding</span>
                            <span class="result-value sub">@_projection.AnnualizedTotalWithholding.ToString("C")</span>
                        </div>
                        @if (_projection.OverUnderWithholding > 0)
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Withholding-Based Estimate (Over)</span>
                                <span class="result-value refund-value">@_projection.OverUnderWithholding.ToString("C")</span>
                            </div>
                        }
                        else if (_projection.OverUnderWithholding < 0)
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Withholding-Based Estimate (Shortfall)</span>
                                <span class="result-value owe-value">@Math.Abs(_projection.OverUnderWithholding).ToString("C")</span>
                            </div>
                        }
                        else
                        {
                            <div class="result-row over-under-row">
                                <span class="over-under-label">Withholding-Based Estimate (Balanced)</span>
                                <span class="result-value">$0.00</span>
                            </div>
                        }
                    </div>
                    <div class="result-card">
                        <div class="result-card-title">Annual Assumptions &amp; Exclusions</div>
                        @foreach (var note in _projection.AccuracyNotes)
                        {
                            <p class="form-note"><strong>@note.Title:</strong> @note.Description</p>
                        }
                    </div>
                </div>
            }
        }
    </div><!-- /results panel -->
  </div><!-- /right column -->

</div><!-- /calc-layout -->

<!-- ── SAVED PAYCHECKS & ACCOUNT ─────────────────────────────── -->
<div class="calc-panel history-panel" id="saved-paychecks">
    <ActivityLog History="_history"
                 PendingDeleteName="_pendingDeleteName"
                 OnRequestDelete="RequestDelete"
                 OnConfirmDelete="ConfirmDeleteAsync"
                 OnCancelDelete="CancelDelete" />
    <div class="history-body">

        <div class="history-list-section">
            @if (_history.Count >= 2)
            {
                <div class="compare-block">
                    <h3 class="history-subtitle compare-title">Compare A / B</h3>
                    <div class="compare-selectors">
                        <div class="form-group">
                            <label>Paycheck A</label>
                            <select @bind="_compareAName" @bind:after="OnCompareAChanged">
                                @foreach (var p in _history)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Paycheck B</label>
                            <select @bind="_compareBName" @bind:after="OnCompareBChanged">
                                @foreach (var p in _history)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    @{
                        var comparisonRows = BuildComparisonRows();
                    }
                    @if (comparisonRows.Count > 0)
                    {
                        <table class="compare-table">
                            <thead>
                                <tr>
                                    <th class="compare-metric">Metric</th>
                                    <th class="compare-num">@_compareAName</th>
                                    <th class="compare-num">@_compareBName</th>
                                    <th class="compare-num">&Delta;</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in comparisonRows)
                                {
                                    <tr class="@(row.Highlight ? "compare-row-highlight" : "")">
                                        <td class="compare-metric">@row.Label</td>
                                        <td class="compare-num">@row.ValueADisplay</td>
                                        <td class="compare-num">@row.ValueBDisplay</td>
                                        <td class="compare-num compare-delta">@row.DifferenceDisplay</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="results-actions compare-actions no-print">
                            <button class="btn-export" @onclick="() => ExportComparisonCsvAsync(comparisonRows)" title="Download the A/B comparison as CSV">CSV</button>
                            <button class="btn-export" @onclick="() => ExportComparisonPdfAsync(comparisonRows)" title="Download the A/B comparison as PDF">PDF</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="account-section" id="account">
            <h3 class="history-subtitle">Account</h3>
            <div class="account-actions" style="margin-bottom: 10px;">
                <a class="btn-secondary" href="/privacy">Privacy policy</a>
                <a class="btn-secondary" href="/terms">Terms</a>
            </div>
            @if (IsSignedIn)
            {
                <p class="account-email">Signed in as <strong>@Account.Email</strong></p>
                <div class="account-actions">
                    <button class="btn-secondary" @onclick="SyncNowAsync" disabled="@_busy">Sync now</button>
                    <button class="btn-secondary" @onclick="ExportAccountDataAsync" disabled="@_busy">Export data</button>
                    @if (_confirmDeleteAccount)
                    {
                        <button class="btn-secondary btn-danger" @onclick="DeleteAccountAsync" disabled="@_busy">Confirm account delete</button>
                        <button class="btn-secondary" @onclick="CancelDeleteAccount" disabled="@_busy">Cancel</button>
                    }
                    else
                    {
                        <button class="btn-secondary btn-danger" @onclick="RequestDeleteAccount" disabled="@_busy">Delete account</button>
                    }
                    <button class="btn-secondary" @onclick="LogoutAsync" disabled="@_busy">Sign out</button>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="_email" autocomplete="username" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" @bind="_password" autocomplete="current-password" />
                </div>
                <div class="account-actions">
                    <button class="btn-calculate account-signin" @onclick="LoginAsync" disabled="@_busy">Sign in</button>
                    <button class="btn-secondary" @onclick="RegisterAsync" disabled="@_busy">Create account</button>
                </div>
                <p class="form-note">Optional. Create an account to sync your saved paychecks between this site and the mobile app.</p>
            }
            <div class="account-actions" style="margin-top: 10px;">
                @if (_confirmDeleteLocal)
                {
                    <button class="btn-secondary btn-danger" @onclick="() => DeleteLocalDataAsync()" disabled="@_busy">Confirm local delete</button>
                    <button class="btn-secondary" @onclick="CancelDeleteLocal" disabled="@_busy">Cancel</button>
                }
                else
                {
                    <button class="btn-secondary btn-danger" @onclick="RequestDeleteLocal" disabled="@_busy">Delete local data</button>
                }
            </div>
            <p class="form-note">Local delete removes paychecks and budgets from this browser session only.</p>
            @if (_accountError != null)
            {
                <div class="calc-error">@_accountError</div>
            }
            @if (_accountStatus != null)
            {
                <div class="account-status">@_accountStatus</div>
            }
        </div>

    </div><!-- /history-body -->
</div><!-- /history panel -->

</div><!-- /calc-page -->

@if (_showModal && _modalExplanation != null)
{
    <ExplanationModal Explanation="_modalExplanation" Sources="ActiveSources" OnClose="CloseModal" />
}

@if (_showSourcesModal)
{
    <AccuracySourcesModal Sources="ActiveSources" TaxYear="ActiveTaxYear" OnClose="CloseSourcesModal" />
}

@code {
    private int _inputTab = 0;
    private int _resultTab = 0;

    // Pay & Hours
    private PayFrequency _frequency = PayFrequency.Biweekly;
    private decimal _hourlyRate = 20m;
    private decimal _regularHours = 80m;
    private decimal _overtimeHours = 0m;
    private decimal _overtimeMultiplier = 1.5m;
    private int _paycheckNumber = 1;
    private decimal _ytdSsWages = 0m;
    private decimal _ytdMedWages = 0m;

    // Calculation mode (standard paycheck vs. gross-up vs. bonus / supplemental wage)
    private string _mode = "standard";
    private bool _grossUpMode => _mode == "grossup";
    private bool _bonusMode => _mode == "bonus";
    private bool _selfEmpMode => _mode == "selfemployment";
    private decimal _targetNet = 1000m;

    // Bonus / supplemental wage
    private decimal _bonusAmount = 5000m;
    private decimal _ytdSupplementalWages = 0m;

    // Self-employment / 1099 (annual net profit)
    private decimal _selfEmpEarnings = 80000m;

    // Federal W-4
    private FederalFilingStatus _fedStatus = FederalFilingStatus.SingleOrMarriedSeparately;
    private bool _step2Checked = false;
    private decimal _step3Credits = 0m;
    private decimal _step4aIncome = 0m;
    private decimal _step4bDeductions = 0m;
    private decimal _step4cExtra = 0m;

    // State
    private UsState _state = UsState.TX;
    private List<StateFieldVm> _stateFields = new();
    private List<string> _stateErrors = new();

    // Deductions
    private List<DeductionVm> _deductions = new();

    // Results
    private PaycheckResult? _result;
    private AnnualProjection? _projection;
    private GrossUpResult? _grossUpResult;
    private BonusResult? _bonusResult;
    private SelfEmploymentResult? _selfEmpResult;
    private string? _calcError;

    // Explanation modal
    private bool _showModal = false;
    private LineExplanation? _modalExplanation;
    private bool _showSourcesModal = false;

    /// <summary>The source citations for whichever result mode is currently active (standard/bonus/self-employment).</summary>
    private IReadOnlyList<SourceCitation> ActiveSources =>
        (_result?.Explanation ?? _bonusResult?.Explanation ?? _selfEmpResult?.Explanation)?.Sources
            ?? Array.Empty<SourceCitation>();

    /// <summary>The tax year backing whichever result mode is currently active.</summary>
    private int ActiveTaxYear =>
        _result?.TaxYear ?? _bonusResult?.TaxYear ?? _selfEmpResult?.TaxYear ?? TaxYearSupport.Default;

    private IReadOnlyList<AccuracyNote> ActiveAccuracyNotes =>
        _bonusResult?.AccuracyNotes ?? _selfEmpResult?.AccuracyNotes ?? Array.Empty<AccuracyNote>();

    private IReadOnlyList<QuarterlyEstimate> ActiveQuarterlyEstimates =>
        _selfEmpResult?.QuarterlyEstimates ?? Array.Empty<QuarterlyEstimate>();

    // Saved paychecks (session) + account
    private string _paycheckName = "";
    private string _exportFileName = "";
    private List<SavedPaycheckDto> _history = new();
    private string _email = "";
    private string _password = "";
    private string? _accountError;
    private string? _accountStatus;
    private bool _busy = false;
    private bool _confirmDeleteLocal;
    private bool _confirmDeleteAccount;
    private bool IsSignedIn => Account.IsSignedIn;

    // ── App chrome (sidebar badge + top bar), owned by MainLayout ─────────────
    [CascadingParameter] private ShellState Shell { get; set; } = default!;

    /// <summary>
    /// Top-bar heading. The state landing pages pass a state-specific title; everything
    /// else falls back to the generic one.
    /// </summary>
    [Parameter] public string? PageTitle { get; set; }

    private bool HasResultForExport => _result != null || _bonusResult != null || _selfEmpResult != null;

    /// <summary>Rendered by MainLayout into the top bar's right-hand action slot.</summary>
    private RenderFragment TopBarActions => @<button class="btn-dark" @onclick="ExportPdfAsync" disabled="@(!HasResultForExport)"
                                                     title="Download the full pay stub as PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 16V4" /><polyline points="7 9 12 4 17 9" /><path d="M4 20h16" />
        </svg>
        Export Pay Stub
    </button>;

    /// <summary>Context line under the hero figure, e.g. "Based on a $52,000 gross salary · Single · Texas".</summary>
    private string HeroSubtitle()
    {
        if (_projection is null) return "";
        var stateName = StateMetadata.GetByState(_state)?.FullName ?? _state.ToString();
        return $"Based on a {_projection.AnnualizedGrossPay:C0} gross salary · {FilingStatusLabel(_fedStatus)} · {stateName}";
    }

    private static string FilingStatusLabel(FederalFilingStatus status) => status switch
    {
        FederalFilingStatus.SingleOrMarriedSeparately => "Single",
        FederalFilingStatus.MarriedFilingJointly => "Married Joint",
        FederalFilingStatus.HeadOfHousehold => "Head of Household",
        _ => status.ToString(),
    };

    // The web calculator collects gross as an hourly rate × hours; PaycheckInput.PayType
    // is left at its Hourly default. Saved paychecks synced from the MAUI app may be salaried.
    private static string PayBasisLabel() => "Hourly pay";

    private bool HasPayEntered() => _selfEmpMode
        ? _selfEmpEarnings > 0
        : _bonusMode
            ? _bonusAmount > 0
            : _grossUpMode
                ? _targetNet > 0
                : _hourlyRate > 0 && _regularHours > 0;

    protected override async Task OnInitializedAsync()
    {
        if (InitialState.HasValue)
            _state = InitialState.Value;
        LoadStateFields();
        Shell.Set(PageTitle ?? "Paycheck Calculator", TopBarActions);
        await RefreshHistoryAsync();
    }

    private bool _lastExportAvailable;

    // The top-bar export button lives in MainLayout's render tree, so it only picks up
    // a newly-available result when the layout is told to re-render.
    protected override void OnAfterRender(bool firstRender)
    {
        if (_lastExportAvailable == HasResultForExport) return;
        _lastExportAvailable = HasResultForExport;
        Shell.Refresh();
    }

    private void LoadStateFields()
    {
        var schema = SchemaProvider.GetSchema(_state);
        var preserved = _stateFields.ToDictionary(f => f.Key, StringComparer.OrdinalIgnoreCase);
        _stateFields = schema.Select(def =>
        {
            var vm = new StateFieldVm(def);
            if (preserved.TryGetValue(def.Key, out var old))
                vm.RestoreFrom(old);
            return vm;
        }).ToList();
        _stateErrors.Clear();
    }

    private StateInputValues BuildStateValues()
    {
        var d = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _stateFields)
            d[f.Key] = f.GetValue();
        return new StateInputValues(d);
    }

    private async Task Calculate()
    {
        _calcError = null;
        _stateErrors.Clear();

        // Bonus mode is self-contained: flat supplemental withholding + FICA + state
        // supplemental rate. It ignores hourly/salary, W-4, and deductions, so it skips
        // the paycheck-specific validation below.
        if (_bonusMode)
        {
            CalculateBonus();
            return;
        }

        // Require a name on every deduction before proceeding.
        foreach (var d in _deductions) d.NameError = false;
        var unnamed = _deductions.Where(d => string.IsNullOrWhiteSpace(d.Name)).ToList();
        if (unnamed.Count > 0 && !_selfEmpMode)
        {
            foreach (var d in unnamed) d.NameError = true;
            _calcError = unnamed.Count == 1
                ? "One deduction is missing a name."
                : $"{unnamed.Count} deductions are missing names.";
            _inputTab = 3;
            return;
        }

        // Field-level validation
        var hasFieldErrors = false;
        foreach (var f in _stateFields)
        {
            f.Validate();
            if (f.HasError) hasFieldErrors = true;
        }
        if (hasFieldErrors)
        {
            _calcError = "Please fix the highlighted state field errors.";
            _inputTab = 2;
            return;
        }

        var stateValues = BuildStateValues();

        // Cross-field state validation
        if (StateRegistry.IsSupported(_state))
        {
            var errors = StateRegistry.GetCalculator(_state).Validate(stateValues);
            _stateErrors = errors.ToList();
            if (_stateErrors.Count > 0)
            {
                _calcError = _stateErrors.Count == 1 ? _stateErrors[0]
                    : $"{_stateErrors.Count} state validation errors. Check the State tab.";
                _inputTab = 2;
                return;
            }
        }

        // Self-employment mode reuses the validated state inputs but its own engine.
        if (_selfEmpMode)
        {
            CalculateSelfEmployment(stateValues);
            return;
        }

        var input = new PaycheckInput
        {
            Frequency = _frequency,
            HourlyRate = _hourlyRate,
            RegularHours = _regularHours,
            OvertimeHours = _overtimeHours,
            OvertimeMultiplier = _overtimeMultiplier,
            PaycheckNumber = _paycheckNumber,
            State = _state,
            StateInputValues = stateValues,
            FederalW4 = new FederalW4Input
            {
                FilingStatus = _fedStatus,
                Step2Checked = _step2Checked,
                Step3TaxCredits = _step3Credits,
                Step4aOtherIncome = _step4aIncome,
                Step4bDeductions = _step4bDeductions,
                Step4cExtraWithholding = _step4cExtra
            },
            Deductions = _deductions.Select(d => d.ToDeduction()).ToArray(),
            YtdSocialSecurityWages = _ytdSsWages,
            YtdMedicareWages = _ytdMedWages
        };

        try
        {
            _bonusResult = null;
            if (_grossUpMode)
            {
                _grossUpResult = GrossUpCalc.Calculate(input, _targetNet);
                _result = _grossUpResult.Paycheck;
                _projection = null;
            }
            else
            {
                _grossUpResult = null;
                _result = Calc.Calculate(input);
                _projection = ProjectionCalc.Calculate(input, _result);
            }
            _resultTab = 0;

            // Prefill the export file name from the paycheck name (the user can edit it).
            _exportFileName = _paycheckName.Trim();

            // Save a snapshot of exactly what was calculated, and sync it if signed in.
            await SaveSnapshotAsync(input);
        }
        catch (Exception ex)
        {
            _calcError = $"Calculation error: {ex.Message}";
            _result = null;
            _projection = null;
            _grossUpResult = null;
        }
    }

    private async Task SaveSnapshotAsync(PaycheckInput input)
    {
        if (_result is null) return;

        var isGrossUp = _grossUpResult is not null;
        var name = string.IsNullOrWhiteSpace(_paycheckName)
            ? $"Paycheck {_history.Count + 1}"
            : _paycheckName.Trim();

        var dto = new SavedPaycheckDto
        {
            Name = name,
            UpdatedAtUtc = DateTimeOffset.UtcNow,
            Input = input,
            Result = SavedPaycheckResultMapper.FromResult(
                _result, isGrossUp, isGrossUp ? _grossUpResult!.TargetNetPay : 0m)
        };

        await Store.UpsertAsync(dto);
        await RefreshHistoryAsync();
        if (IsSignedIn) await TrySyncAsync();
    }

    private async Task RefreshHistoryAsync()
    {
        var set = await Store.LoadAsync();
        _history = set.Paychecks.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
        EnsureComparisonSelections();

        // Keep the sidebar badge and the top-bar export button in step with the new state.
        Shell.SetSavedCount(_history.Count);
        Shell.Refresh();
    }

    // ── A/B comparison (session saved paychecks) ─────────────────
    private string? _compareAName;
    private string? _compareBName;

    private IReadOnlyList<ComparisonRow> BuildComparisonRows()
    {
        var a = _history.FirstOrDefault(h => string.Equals(h.Name, _compareAName, StringComparison.OrdinalIgnoreCase))?.Result;
        var b = _history.FirstOrDefault(h => string.Equals(h.Name, _compareBName, StringComparison.OrdinalIgnoreCase))?.Result;
        if (a is null || b is null) return Array.Empty<ComparisonRow>();
        return PaycheckComparison.BuildRows(a, b);
    }

    // Keep the A/B selections valid as paychecks are added, renamed, or deleted:
    // default each to a sensible entry when unset or no longer present, while
    // preserving a selection the user made (even if they pick the same one twice).
    private void EnsureComparisonSelections()
    {
        var names = _history.Select(h => h.Name).ToList();
        if (_compareAName is null || !names.Contains(_compareAName, StringComparer.OrdinalIgnoreCase))
            _compareAName = names.ElementAtOrDefault(0);
        if (_compareBName is null || !names.Contains(_compareBName, StringComparer.OrdinalIgnoreCase))
            _compareBName = names.FirstOrDefault(n => !string.Equals(n, _compareAName, StringComparison.OrdinalIgnoreCase))
                            ?? names.ElementAtOrDefault(0);
    }

    private async Task DeletePaycheckAsync(SavedPaycheckDto dto)
    {
        await Store.RemoveAsync(dto.Name, DateTimeOffset.UtcNow);
        await RefreshHistoryAsync();
        if (IsSignedIn) await TrySyncAsync();
    }

    private string? _pendingDeleteName;
    private void RequestDelete(SavedPaycheckDto dto) => _pendingDeleteName = dto.Name;
    private void CancelDelete() => _pendingDeleteName = null;
    private async Task ConfirmDeleteAsync(SavedPaycheckDto dto)
    {
        _pendingDeleteName = null;
        await DeletePaycheckAsync(dto);
    }

    private void OnCompareAChanged()
    {
        if (string.Equals(_compareAName, _compareBName, StringComparison.OrdinalIgnoreCase))
            _compareBName = _history.FirstOrDefault(h =>
                !string.Equals(h.Name, _compareAName, StringComparison.OrdinalIgnoreCase))?.Name;
    }

    private void OnCompareBChanged()
    {
        if (string.Equals(_compareAName, _compareBName, StringComparison.OrdinalIgnoreCase))
            _compareAName = _history.FirstOrDefault(h =>
                !string.Equals(h.Name, _compareBName, StringComparison.OrdinalIgnoreCase))?.Name;
    }

    private async Task LoginAsync()
    {
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.LoginAsync(_email.Trim(), _password);
        _busy = false;

        if (result.Success)
        {
            Account.Email = _email.Trim();
            _password = "";
            await TrySyncAsync();
        }
        else
        {
            _accountError = result.Error;
        }
    }

    private async Task RegisterAsync()
    {
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.RegisterAsync(_email.Trim(), _password);
        _busy = false;

        if (result.Success)
            await LoginAsync();
        else
            _accountError = result.Error;
    }

    private async Task LogoutAsync()
    {
        await Api.LogoutAsync();
        Account.Email = null;
        _confirmDeleteAccount = false;
        _accountStatus = "Signed out. Saved paychecks remain for this session only.";
        _accountError = null;
    }

    private void RequestDeleteLocal() => _confirmDeleteLocal = true;
    private void CancelDeleteLocal() => _confirmDeleteLocal = false;

    private void RequestDeleteAccount() => _confirmDeleteAccount = true;
    private void CancelDeleteAccount() => _confirmDeleteAccount = false;

    private async Task DeleteLocalDataAsync(bool setStatus = true)
    {
        _confirmDeleteLocal = false;

        await Store.ReplaceAllAsync(new SavedPaycheckSet([], []));
        await BudgetStore.ReplaceAllBudgetsAsync(new BudgetSet([], []));
        await BudgetStore.ReplaceAllTransactionsAsync(new TransactionSet([], []));
        await BudgetStore.ReplaceAllRecurringBillsAsync(new RecurringBillSet([], []));
        await BudgetStore.ReplaceAllSavingsGoalsAsync(new SavingsGoalSet([], []));

        await RefreshHistoryAsync();
        if (setStatus)
            _accountStatus = "Local paycheck and budget data deleted for this browser session.";
        _accountError = null;
    }

    private async Task ExportAccountDataAsync()
    {
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.ExportAccountDataAsync();
        _busy = false;

        if (!result.Success || string.IsNullOrWhiteSpace(result.Value))
        {
            _accountError = result.Error ?? "Could not export account data.";
            return;
        }

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(result.Value));
        await JS.InvokeVoidAsync(
            "paycheckExport.downloadFile",
            $"paycheckcalc-account-export-{DateTime.UtcNow:yyyyMMdd}.json",
            "application/json",
            base64);
        _accountStatus = "Account data exported.";
    }

    private async Task DeleteAccountAsync()
    {
        _confirmDeleteAccount = false;
        _accountError = null;
        _accountStatus = null;
        _busy = true;
        var result = await Api.DeleteAccountAsync();
        _busy = false;

        if (!result.Success)
        {
            _accountError = result.Error ?? "Could not delete account.";
            return;
        }

        Account.Email = null;
        await DeleteLocalDataAsync(setStatus: false);
        _accountStatus = "Account and synced cloud data deleted.";
    }

    private Task SyncNowAsync() => TrySyncAsync();

    private async Task TrySyncAsync()
    {
        _busy = true;
        var outcome = await Sync.SyncAsync();
        _busy = false;

        if (outcome.Success)
        {
            await RefreshHistoryAsync();
            _accountStatus = $"Synced {_history.Count} paycheck(s) at {DateTime.Now:t}.";
            _accountError = null;
        }
        else
        {
            _accountError = outcome.Error;
        }
    }

    private void CalculateBonus()
    {
        _result = null;
        _projection = null;
        _grossUpResult = null;
        try
        {
            _bonusResult = BonusCalc.Calculate(new BonusInput
            {
                BonusAmount = _bonusAmount,
                State = _state,
                YtdSupplementalWages = _ytdSupplementalWages,
                YtdSocialSecurityWages = _ytdSsWages,
                YtdMedicareWages = _ytdMedWages
            });
        }
        catch (Exception ex)
        {
            _calcError = $"Calculation error: {ex.Message}";
            _bonusResult = null;
        }
    }

