    private void OnModeChanged()
    {
        // Switching modes clears stale results so the panel doesn't mix views.
        _result = null;
        _projection = null;
        _grossUpResult = null;
        _bonusResult = null;
        _selfEmpResult = null;
        _calcError = null;
    }

