    // ── Export / print ──────────────────────────────────────────
    // CSV and PDF export the per-paycheck results plus the annual projection, and
    // append the A/B comparison when two paychecks are selected (mirroring the mobile
    // app). Print uses the browser's print dialog with a print stylesheet, so it
    // captures whichever results tab (Per Paycheck or Annual) is on screen.
    private async Task ExportCsvAsync()
    {
        var exportResult = BuildActiveExportResult();
        if (exportResult is null) return;
        var comparison = _result is null ? Array.Empty<ComparisonRow>() : BuildComparisonRows();
        var csv = PaycheckCsvRenderer.Render(
            exportResult,
            exportResult.State.ToString(),
            _projection,
            comparison.Count > 0 ? comparison : null,
            _compareAName ?? "Paycheck A",
            _compareBName ?? "Paycheck B",
            ActiveAccuracyNotes,
            ActiveQuarterlyEstimates);
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(csv));
        await JS.InvokeVoidAsync("paycheckExport.downloadFile", ExportFileName("csv"), "text/csv", base64);
    }

    private async Task ExportPdfAsync()
    {
        var exportResult = BuildActiveExportResult();
        if (exportResult is null) return;
        var comparison = _result is null ? Array.Empty<ComparisonRow>() : BuildComparisonRows();
        var bytes = PaycheckPdfRenderer.Render(
            exportResult,
            exportResult.State.ToString(),
            _projection,
            comparison.Count > 0 ? comparison : null,
            _compareAName ?? "Paycheck A",
            _compareBName ?? "Paycheck B",
            ActiveAccuracyNotes,
            ActiveQuarterlyEstimates);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("paycheckExport.downloadFile", ExportFileName("pdf"), "application/pdf", base64);
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("paycheckExport.print");

    private PaycheckResult? BuildActiveExportResult()
    {
        if (_result is not null) return _result;
        if (_bonusResult is not null)
        {
            return new PaycheckResult
            {
                GrossPay = _bonusResult.BonusAmount,
                FederalTaxableIncome = _bonusResult.BonusAmount,
                FicaTaxableWages = _bonusResult.BonusAmount,
                StateTaxableWages = _bonusResult.BonusAmount,
                FederalWithholding = _bonusResult.FederalWithholding,
                SocialSecurityWithholding = _bonusResult.SocialSecurityWithholding,
                MedicareWithholding = _bonusResult.MedicareWithholding,
                AdditionalMedicareWithholding = _bonusResult.AdditionalMedicareWithholding,
                StateWithholding = _bonusResult.StateWithholding,
                NetPay = _bonusResult.NetBonus,
                State = _bonusResult.State,
                TaxYear = _bonusResult.TaxYear,
                Explanation = _bonusResult.Explanation
            };
        }
        if (_selfEmpResult is not null)
        {
            return new PaycheckResult
            {
                GrossPay = _selfEmpResult.AnnualNetEarnings,
                FederalTaxableIncome = _selfEmpResult.NetEarningsSubjectToSeTax,
                FicaTaxableWages = _selfEmpResult.NetEarningsSubjectToSeTax,
                StateTaxableWages = _selfEmpResult.AnnualNetEarnings,
                FederalWithholding = _selfEmpResult.SelfEmploymentTax,
                SocialSecurityWithholding = _selfEmpResult.SocialSecurityTax,
                MedicareWithholding = _selfEmpResult.MedicareTax,
                AdditionalMedicareWithholding = _selfEmpResult.AdditionalMedicareTax,
                StateWithholding = _selfEmpResult.StateIncomeTax,
                NetPay = _selfEmpResult.TakeHome,
                State = _selfEmpResult.State,
                TaxYear = _selfEmpResult.TaxYear,
                Explanation = _selfEmpResult.Explanation
            };
        }
        return null;
    }

