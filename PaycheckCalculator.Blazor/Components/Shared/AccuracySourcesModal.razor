@using PaycheckCalculator.Core.Explanation

<div class="modal-overlay" @onclick="OnOverlayClick">
    <div class="modal-container" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h3>Accuracy &amp; Sources (@TaxYear)</h3>
            <button class="modal-close" @onclick="OnClose" title="Close">&#x2715;</button>
        </div>
        <div class="modal-body">
            @if (Sources.Count == 0)
            {
                <div class="explanation-step">
                    <div class="step-detail">No source citations are available for this result.</div>
                </div>
            }
            else
            {
                @foreach (var source in Sources)
                {
                    <div class="explanation-step">
                        <div class="step-label">@source.Label</div>
                        <div class="step-detail"><strong>@source.PublicationTitle</strong></div>
                        @if (!string.IsNullOrWhiteSpace(source.OfficialUrl))
                        {
                            <div class="explanation-reference">
                                <a href="@source.OfficialUrl" target="_blank" rel="noopener noreferrer">Official publication</a>
                            </div>
                        }
                        <div class="step-detail">
                            Tax year: @(source.TaxYear?.ToString() ?? TaxYear.ToString())
                            @if (source.EffectiveDate is not null)
                            {
                                <span> &middot; Effective @source.EffectiveDate.Value.ToString("yyyy-MM-dd")</span>
                            }
                            @if (source.RevisionDate is not null)
                            {
                                <span> &middot; Revised @source.RevisionDate.Value.ToString("yyyy-MM-dd")</span>
                            }
                        </div>
                        @if (source.ImplementationType is not null)
                        {
                            <div class="step-detail">Implementation: @source.ImplementationType</div>
                        }
                        @if (source.LastVerificationDate is not null)
                        {
                            <div class="step-detail">Last verified: @source.LastVerificationDate.Value.ToString("yyyy-MM-dd")</div>
                        }
                        @foreach (var note in source.Approximations)
                        {
                            <div class="step-detail"><strong>Approximation:</strong> @note</div>
                        }
                        @foreach (var note in source.Exclusions)
                        {
                            <div class="step-detail"><strong>Exclusion:</strong> @note</div>
                        }
                    </div>
                }
            }
        </div>
        <div class="modal-footer">
            <button class="btn-primary" @onclick="OnClose">Close</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SourceCitation> Sources { get; set; } = Array.Empty<SourceCitation>();
    [Parameter] public int TaxYear { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private Task OnOverlayClick() => OnClose.InvokeAsync();
}
