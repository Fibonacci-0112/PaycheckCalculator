<div class="modal-overlay" @onclick="OnOverlayClick">
    <div class="modal-container" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h3>@Explanation.Title</h3>
            <button class="modal-close" @onclick="OnClose" title="Close">&#x2715;</button>
        </div>
        <div class="modal-body">
            <div class="modal-amount">
                <span>Amount: </span><strong>@Explanation.FinalAmount.ToString("C")</strong>
            </div>
            @foreach (var step in Explanation.Steps)
            {
                <div class="explanation-step">
                    <div class="step-label">@step.Label</div>
                    @if (!string.IsNullOrEmpty(step.Detail))
                    {
                        <div class="step-detail">@step.Detail</div>
                    }
                    @if (!string.IsNullOrEmpty(step.Formula))
                    {
                        <div class="step-formula">@step.Formula</div>
                    }
                    @if (step.Value.HasValue)
                    {
                        <div class="step-value">@step.Value.Value.ToString("C")</div>
                    }
                </div>
            }
            @{
                var lineSources = Sources
                    .Where(source => source.RuleId is not null
                        && Explanation.SourceRuleIds?.Contains(source.RuleId) == true)
                    .ToList();
            }
            @if (lineSources.Count > 0)
            {
                @foreach (var source in lineSources)
                {
                    <div class="explanation-reference">
                        Source: <a href="@source.OfficialUrl" target="_blank" rel="noopener noreferrer">@source.PublicationTitle</a>
                        @if (source.EffectiveDate is not null)
                        {
                            <span> (effective @source.EffectiveDate.Value.ToString("yyyy-MM-dd"))</span>
                        }
                        <div>Implementation: @source.ImplementationType; verified @source.LastVerificationDate?.ToString("yyyy-MM-dd")</div>
                        @foreach (var note in source.Approximations)
                        {
                            <div>Approximation: @note</div>
                        }
                        @foreach (var note in source.Exclusions)
                        {
                            <div>Exclusion: @note</div>
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(Explanation.Reference))
            {
                <div class="explanation-reference">Source: @Explanation.Reference</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn-primary" @onclick="OnClose">Close</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LineExplanation Explanation { get; set; } = null!;
    [Parameter] public IReadOnlyList<PaycheckCalculator.Core.Explanation.SourceCitation> Sources { get; set; }
        = Array.Empty<PaycheckCalculator.Core.Explanation.SourceCitation>();
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private Task OnOverlayClick() => OnClose.InvokeAsync();
}
