@inherits LayoutComponentBase
@implements IDisposable

<CascadingValue Value="_shell" IsFixed="true">
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="4" y="2" width="16" height="20" rx="2" />
                        <line x1="8" y1="6" x2="16" y2="6" />
                        <line x1="8" y1="11" x2="8" y2="11" />
                        <line x1="12" y1="11" x2="12" y2="11" />
                        <line x1="16" y1="11" x2="16" y2="11" />
                        <line x1="8" y1="15" x2="8" y2="15" />
                        <line x1="12" y1="15" x2="12" y2="15" />
                        <line x1="16" y1="15" x2="16" y2="18" />
                        <line x1="8" y1="18" x2="12" y2="18" />
                    </svg>
                </span>
                <span class="brand-text">
                    <span class="brand-name">PaycheckCalculator</span>
                    <span class="brand-sub">Tax Year @TaxYearSupport.Default</span>
                </span>
            </div>

            <nav class="nav-list">
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="4" y1="8" x2="12" y2="8" /><line x1="8" y1="4" x2="8" y2="12" />
                        <line x1="15" y1="8" x2="21" y2="8" />
                        <line x1="4" y1="17" x2="10" y2="17" />
                        <line x1="14" y1="14" x2="20" y2="20" /><line x1="20" y1="14" x2="14" y2="20" />
                    </svg>
                    <span class="nav-label">Calculator</span>
                </NavLink>

                <NavLink class="nav-item" href="budget">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <line x1="3" y1="9" x2="21" y2="9" />
                        <line x1="9" y1="9" x2="9" y2="20" />
                    </svg>
                    <span class="nav-label">Budget</span>
                </NavLink>

                <a class="nav-item" href="/#saved-paychecks">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 3-6.7" /><polyline points="3 4 3 9 8 9" />
                        <polyline points="12 8 12 12 15 14" />
                    </svg>
                    <span class="nav-label">Saved Paychecks</span>
                    @if (_shell.SavedCount > 0)
                    {
                        <span class="nav-badge">@_shell.SavedCount</span>
                    }
                </a>

                <a class="nav-item" href="/#account">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21v-1a7 7 0 0 1 16 0v1" />
                    </svg>
                    <span class="nav-label">Account &amp; Sync</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="/privacy">Privacy Policy</a>
                <a href="/terms">Terms of Use</a>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <h1 class="topbar-title">@_shell.Title</h1>
                <span class="status-pill">
                    <span class="status-dot"></span>@TaxYearSupport.Default IRS tables current
                </span>
                @if (_shell.Actions is not null)
                {
                    <div class="topbar-actions">@_shell.Actions</div>
                }
            </header>

            <main class="site-main">
                @Body
            </main>

            <footer class="site-footer">
                <p>
                    Based on @TaxYearSupport.Default IRS Publication 15-T and state withholding tables.
                    For informational purposes only — not tax advice.
                </p>
            </footer>
        </div>
    </div>
</CascadingValue>

@code {
    private readonly ShellState _shell = new();

    protected override void OnInitialized() => _shell.Changed += OnShellChanged;

    // Marshalled onto the renderer's sync context so a page pushing chrome state from
    // OnInitialized (i.e. while this layout is still rendering) queues instead of throwing.
    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => _shell.Changed -= OnShellChanged;
}
