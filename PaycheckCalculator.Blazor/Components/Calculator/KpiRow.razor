@* Four annualized headline figures with percent-of-gross badges. *@

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-head">
            <span class="kpi-label">Gross Annual Pay</span>
            <span class="card-chip chip-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="2" x2="12" y2="22" />
                    <path d="M17 6.5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </span>
        </div>
        <div class="kpi-value">@Projection.AnnualizedGrossPay.ToString("C")</div>
        <span class="kpi-badge up">&#8599; @PayBasisLabel</span>
    </div>

    <div class="kpi-card">
        <div class="kpi-head">
            <span class="kpi-label">FICA Withholdings</span>
            <span class="card-chip chip-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </span>
        </div>
        <div class="kpi-value">@Projection.AnnualizedFica.ToString("C")</div>
        <span class="kpi-badge down">&#8722; @PercentOfGross(Projection.AnnualizedFica) of gross</span>
    </div>

    <div class="kpi-card">
        <div class="kpi-head">
            <span class="kpi-label">Federal Income Tax</span>
            <span class="card-chip chip-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 3h18l-7 8v7l-4 3v-10z" />
                </svg>
            </span>
        </div>
        <div class="kpi-value">@Projection.AnnualizedFederalWithholding.ToString("C")</div>
        <span class="kpi-badge down">&#8722; @PercentOfGross(Projection.AnnualizedFederalWithholding) of gross</span>
    </div>

    <div class="kpi-card">
        <div class="kpi-head">
            <span class="kpi-label">State Income Tax</span>
            <span class="card-chip chip-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
            </span>
        </div>
        <div class="kpi-value">@Projection.AnnualizedStateWithholding.ToString("C")</div>
        <span class="kpi-badge @(Projection.AnnualizedStateWithholding > 0 ? "down" : "neutral")">
            @if (Projection.AnnualizedStateWithholding > 0)
            {
                @($"− {PercentOfGross(Projection.AnnualizedStateWithholding)} · {State}")
            }
            else
            {
                @($"No withholding · {State}")
            }
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AnnualProjection Projection { get; set; } = null!;

    /// <summary>Two-letter state code shown on the state-tax badge.</summary>
    [Parameter] public string State { get; set; } = "";

    /// <summary>"Base salary" or "Hourly", describing how gross was entered.</summary>
    [Parameter] public string PayBasisLabel { get; set; } = "Base pay";

    private string PercentOfGross(decimal amount)
    {
        if (Projection.AnnualizedGrossPay <= 0) return "0.00%";
        return (amount / Projection.AnnualizedGrossPay).ToString("P2");
    }
}
