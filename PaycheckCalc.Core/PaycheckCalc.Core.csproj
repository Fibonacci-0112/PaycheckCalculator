<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Dynamically select target frameworks based on the installed SDK.
      - SDK >= .NET 10: build net10.0 (primary target for MAUI/Blazor/Tests) AND net9.0.
      - SDK <  .NET 10: build net9.0 only (MAUI/Blazor/Tests require .NET 10+).
      This avoids NETSDK1045 "unsupported target framework" when building Core
      with the stable .NET 9 SDK on CI or developer machines.
    -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppTargetFrameworkVersion)', '10.0'))">net10.0;net9.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionLessThan('$(BundledNETCoreAppTargetFrameworkVersion)', '10.0'))">net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\ok_ow2_2026_percentage.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\ca_method_b_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\ar_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\co_dr0004_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\connecticut_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\Federal2026\federal_1040_brackets_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\pa_eit_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\nyc_withholding_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\oh_rita_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\oh_cca_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\md_county_surtax_2026.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Data\Schemas\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- net10.0-only packages (QuestPDF PDF rendering, kept out of the net9.0 fallback) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
  </ItemGroup>

  <!-- net9.0 (Web/WASM) build: exclude QuestPDF and the PDF exporters that depend on it -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <Compile Remove="Export/PdfPaycheckExporter.cs" />
    <Compile Remove="Export/PdfSelfEmploymentExporter.cs" />
  </ItemGroup>

</Project>
